---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { legalConfig, legalNav } from '../data/legal';
import { site } from '../data/site';
import SiteLayout from './SiteLayout.astro';
import { withBase } from '../lib/paths.mjs';

interface Props {
  title: string;
  summary: string;
  audience?: string;
  slug?: string;
  isIndex?: boolean;
}

const {
  title,
  summary,
  audience = 'Customers and community members',
  slug,
  isIndex = false,
} = Astro.props;
const pageTitle = `${title} — ${site.name}`;
---

<SiteLayout
  title={pageTitle}
  description={summary}
  noindex={legalConfig.isDraft}
  pageType="webpage"
>
  <div id="top"></div>
  <Header brandLabel={`${site.name} Legal`} />

  <main id="main-content" class="legal-main">
    <header class="legal-hero">
      <div class="container legal-hero-inner">
        <a class="legal-back" href={site.links.legal}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="m9.75 3.5-4.5 4.5 4.5 4.5M5.5 8h6" />
          </svg>
          Legal centre
        </a>

        <div class="legal-status-row">
          <span class="legal-kicker">Legal and data</span>
          {legalConfig.isDraft && (
            <span class="draft-state">Draft · launch details required</span>
          )}
        </div>

        <h1 class="display">{title}</h1>
        <p class="legal-summary">{summary}</p>

        <dl class="legal-meta">
          <div>
            <dt>Status</dt>
            <dd>{legalConfig.version}</dd>
          </div>
          <div>
            <dt>Last updated</dt>
            <dd>{legalConfig.effectiveDate}</dd>
          </div>
          <div>
            <dt>Who it is for</dt>
            <dd>{audience}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="container legal-layout">
      <aside class="legal-sidebar">
        <nav aria-label="Legal documents">
          <p>Documents</p>
          <a
            href={site.links.legal}
            class:list={{ active: isIndex }}
            aria-current={isIndex ? 'page' : undefined}
          >
            Overview
          </a>
          {legalNav.map((item) => (
            <a
              href={item.href}
              class:list={{ active: item.href === withBase(`/legal/${slug}/`) }}
              aria-current={
                item.href === withBase(`/legal/${slug}/`) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="launch-card">
          <span>Before launch</span>
          <p>
            Replace the bracketed operator, contact, retention and
            infrastructure fields, then obtain review for the actual business
            and customer locations.
          </p>
        </div>
      </aside>

      <article class="legal-document">
        <slot />
      </article>
    </div>
  </main>

  <Footer />
</SiteLayout>

<style>
  .legal-main {
    min-height: 80vh;
  }

  .legal-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(
        ellipse 56% 90% at 50% 0%,
        rgba(86, 137, 232, 0.075),
        transparent 72%
      ),
      #0a0a0d;
  }

  .legal-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    content: '';
    mask-image: radial-gradient(
      ellipse 50% 80% at 50% 12%,
      black,
      transparent 82%
    );
    opacity: 0.28;
    pointer-events: none;
  }

  .legal-hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(62px, 8vw, 110px) clamp(54px, 7vw, 92px);
  }

  .legal-back {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 570;
    transition: color 180ms ease;
  }

  .legal-back:hover {
    color: var(--text);
  }

  .legal-back svg {
    width: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
    transition: transform 180ms ease;
  }

  .legal-back:hover svg {
    transform: translateX(-2px);
  }

  .legal-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }

  .legal-kicker,
  .draft-state {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    padding-inline: 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .legal-kicker {
    color: #a9c3f3;
    border-color: rgba(86, 137, 232, 0.22);
    background: rgba(86, 137, 232, 0.07);
  }

  .draft-state {
    color: #e2b56f;
    border-color: rgba(214, 166, 93, 0.22);
    background: rgba(214, 166, 93, 0.055);
  }

  .legal-hero h1 {
    max-width: 900px;
    margin-top: 22px;
    font-size: clamp(3rem, 7vw, 5.8rem);
    text-wrap: balance;
  }

  .legal-summary {
    max-width: 700px;
    margin-top: 22px;
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }

  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px clamp(26px, 5vw, 64px);
    margin-top: 40px;
  }

  .legal-meta div {
    min-width: 132px;
  }

  .legal-meta dt {
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .legal-meta dd {
    max-width: 42ch;
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 226px minmax(0, 820px);
    justify-content: space-between;
    gap: clamp(48px, 8vw, 120px);
    padding-block: clamp(58px, 8vw, 108px) clamp(90px, 10vw, 140px);
  }

  .legal-sidebar {
    align-self: start;
    position: sticky;
    top: calc(var(--header-height) + 28px);
  }

  .legal-sidebar nav {
    display: flex;
    flex-direction: column;
  }

  .legal-sidebar nav > p,
  .launch-card > span {
    margin-bottom: 10px;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal-sidebar nav a {
    min-height: 42px;
    display: flex;
    align-items: center;
    padding-inline: 11px;
    border-left: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.86rem;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .legal-sidebar nav a:hover {
    border-left-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.02);
    color: var(--text);
  }

  .legal-sidebar nav a.active {
    border-left-color: var(--blue);
    background: rgba(86, 137, 232, 0.055);
    color: #dce7fb;
  }

  .launch-card {
    margin-top: 28px;
    padding: 15px;
    border: 1px solid rgba(214, 166, 93, 0.17);
    border-radius: 9px;
    background: rgba(214, 166, 93, 0.04);
  }

  .launch-card > span {
    display: block;
    margin-bottom: 7px;
    color: #d9ad6b;
  }

  .launch-card p {
    color: var(--text-dim);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .legal-document {
    min-width: 0;
  }

  @media (max-width: 860px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .legal-sidebar {
      position: static;
    }

    .legal-sidebar nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 9px;
    }

    .legal-sidebar nav > p {
      grid-column: 1 / -1;
      margin: 0;
      padding: 12px;
      border-bottom: 1px solid var(--border);
    }

    .legal-sidebar nav a {
      min-height: 44px;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      border-left: 0;
    }

    .launch-card {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .legal-hero h1 {
      font-size: clamp(2.75rem, 14vw, 4rem);
    }

    .legal-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .legal-meta div:last-child {
      grid-column: 1 / -1;
    }

    .legal-sidebar nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-back svg {
      transition: none;
    }
  }
</style>
