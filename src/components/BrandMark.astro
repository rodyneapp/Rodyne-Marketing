---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['brand-mark', className]} aria-hidden="true">
  <span></span>
  <span></span>
  <span></span>
  <span></span>
</span>

<style>
  .brand-mark {
    display: grid;
    grid-template-columns: repeat(2, 7px);
    gap: 2px;
    width: 18px;
    height: 18px;
    padding: 1px;
    transform: rotate(-8deg);
  }

  .brand-mark span {
    display: block;
    border: 1px solid color-mix(in srgb, var(--blue) 80%, white);
    border-radius: 2px;
    background: color-mix(in srgb, var(--blue) 20%, transparent);
  }

  .brand-mark span:nth-child(2),
  .brand-mark span:nth-child(3) {
    background: color-mix(in srgb, var(--blue) 72%, white 4%);
  }
</style>
