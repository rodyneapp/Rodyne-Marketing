---
import { Image } from 'astro:assets';
import rodyneMark from '../assets/rodyne-mark.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['brand-mark', className]} aria-hidden="true">
  <Image src={rodyneMark} alt="" width={64} height={64} format="webp" />
</span>

<style>
  .brand-mark {
    display: inline-flex;
    width: var(--brand-mark-size, 28px);
    height: var(--brand-mark-size, 28px);
    flex: 0 0 auto;
  }

  .brand-mark :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
