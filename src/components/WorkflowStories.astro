---
import { Image } from 'astro:assets';
import avatar from '../assets/chrxs-dev-avatar.webp';
import Icon from './Icon.astro';
---

<section
  class="section workflows"
  id="workflows"
  aria-label="Community workflows"
>
  <div class="container">
    <article class="workflow" data-observe-reveal>
      <div class="story-copy">
        <p class="eyebrow">01 / Ranks and roles</p>
        <h2 class="display section-title">
          Keep ranks
          <br />
          in sync.
        </h2>
        <p class="section-copy">
          A promotion should reach the right places. Bring the request, staff
          approval and platform results into one clear flow.
        </p>
        <ul class="benefits">
          <li>
            <Icon name="check" size={16} />
            Map Roblox ranks to Discord roles
          </li>
          <li>
            <Icon name="check" size={16} />
            Keep protected roles behind approval
          </li>
          <li>
            <Icon name="check" size={16} />
            See when each change is confirmed
          </li>
        </ul>
        <a class="text-link" href="#security">
          Stay in control <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="workflow-panel panel">
        <div class="panel-bar">
          <span>
            <Icon name="ranking" size={16} />
            Promotion request
          </span>
          <span class="demo-label">Sample data</span>
        </div>
        <div class="promotion-person">
          <Image src={avatar} width={48} height={48} alt="" loading="lazy" />
          <div>
            <strong>chrxs_dev</strong>
            <p>
              Host <span>→</span> Senior Host
            </p>
          </div>
          <span class="status status--green">Approved</span>
        </div>
        <ol class="promotion-steps">
          <li>
            <span class="step-icon">
              <Icon name="shield" size={18} />
            </span>
            <div>
              <strong>Staff approval recorded</strong>
              <p>Approved by MiraNorth</p>
            </div>
            <Icon name="check" size={17} />
          </li>
          <li>
            <span class="step-icon">
              <Icon name="cube" size={18} />
            </span>
            <div>
              <strong>Roblox rank updated</strong>
              <p>Senior Host · confirmed</p>
            </div>
            <Icon name="check" size={17} />
          </li>
          <li>
            <span class="step-icon">
              <Icon name="discord" size={18} />
            </span>
            <div>
              <strong>Discord role synced</strong>
              <p>@Senior Host · confirmed</p>
            </div>
            <Icon name="check" size={17} />
          </li>
        </ol>
        <div class="panel-foot">
          <Icon name="note" size={15} />
          Saved to the member’s history
        </div>
      </div>
    </article>

    <article class="workflow workflow--reverse" data-observe-reveal>
      <div class="story-copy">
        <p class="eyebrow">02 / Sessions and training</p>
        <h2 class="display section-title">
          From “who’s hosting?”
          <br />
          to all set.
        </h2>
        <p class="section-copy">
          Give your staff a shared plan for every session, from the first
          Discord reminder to the final training result.
        </p>
        <ul class="benefits">
          <li>
            <Icon name="check" size={16} />
            Schedule sessions with assigned hosts
          </li>
          <li>
            <Icon name="check" size={16} />
            Send Discord RSVPs and reminders
          </li>
          <li>
            <Icon name="check" size={16} />
            Record attendance and results separately
          </li>
        </ul>
      </div>
      <div class="workflow-panel session-panel panel">
        <div class="panel-bar">
          <span>
            <Icon name="calendar" size={16} />
            Community schedule
          </span>
          <span class="demo-label">Sample data</span>
        </div>
        <div class="session-heading">
          <div class="date-tile">
            <span>SAT</span>
            <strong>12</strong>
          </div>
          <div>
            <p>September · 18:00 UTC</p>
            <h3>Front Desk Training</h3>
            <span>Hosted by MiraNorth</span>
          </div>
        </div>
        <div class="session-progress" aria-label="Session completed">
          <span>
            <i></i>Scheduled
          </span>
          <span>
            <i></i>Check-in
          </span>
          <span>
            <i></i>Results saved
          </span>
        </div>
        <div class="session-numbers">
          <div>
            <strong>24</strong>
            <span>RSVPs</span>
          </div>
          <div>
            <strong>21</strong>
            <span>Attended</span>
          </div>
          <div>
            <strong>18</strong>
            <span>Passed training</span>
          </div>
        </div>
        <div class="session-notice">
          <Icon name="discord" size={18} />
          <div>
            <strong>Your staff know what’s next.</strong>
            <p>Reminder delivered to #training-sessions</p>
          </div>
          <Icon name="check" size={16} />
        </div>
        <div class="panel-foot">
          <Icon name="note" size={15} />
          Host-confirmed results, attached to each member
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .workflows {
    padding-bottom: 0;
  }
  .workflow {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 7vw, 100px);
    align-items: center;
    padding-bottom: clamp(80px, 10vw, 132px);
  }
  .workflow + .workflow {
    border-top: 1px solid var(--border);
    padding-top: clamp(80px, 10vw, 132px);
  }
  .workflow--reverse {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }
  .workflow--reverse .story-copy {
    order: 2;
  }
  .section-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.1;
  }
  .section-copy {
    max-width: 42ch;
    font-size: 1rem;
  }
  .benefits {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 26px;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .benefits li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .benefits :global(svg) {
    flex-shrink: 0;
    color: #9eb9eb;
  }
  .text-link {
    margin-top: 20px;
  }
  .workflow-panel {
    overflow: hidden;
    min-width: 0;
    background: linear-gradient(140deg, #5689e809, transparent 55%), #101115;
  }
  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .panel-bar > span:first-child {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .promotion-person {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    padding: 28px 24px;
  }
  .promotion-person img {
    border-radius: 12px;
    background: var(--surface-raised);
  }
  .promotion-person strong {
    font-size: 1rem;
    font-weight: 600;
  }
  .promotion-person p {
    margin-top: 3px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .promotion-person p span {
    margin-inline: 6px;
    color: var(--text-faint);
  }
  .promotion-person .status {
    margin-left: auto;
  }
  .promotion-steps {
    list-style: none;
    padding: 0 24px 24px;
  }
  .promotion-steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
  }
  .promotion-steps li + li {
    border-top: 1px solid var(--border);
  }
  .step-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background: #ffffff04;
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text-secondary);
  }
  .promotion-steps strong,
  .session-notice strong {
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .promotion-steps p,
  .session-notice p {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .promotion-steps li > :global(svg:last-child) {
    margin-left: auto;
    color: var(--green);
    flex-shrink: 0;
  }
  .panel-foot {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    background: #ffffff02;
    font-size: 0.8125rem;
  }
  .panel-foot :global(svg) {
    flex-shrink: 0;
  }
  .session-heading {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 28px 24px;
  }
  .date-tile {
    flex-shrink: 0;
    width: 64px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    text-align: center;
    overflow: hidden;
  }
  .date-tile span {
    display: block;
    padding: 5px;
    background: #ffffff06;
    font: 0.75rem var(--mono);
    color: var(--text-dim);
  }
  .date-tile strong {
    display: block;
    font-size: 1.7rem;
    font-weight: 500;
    padding: 2px 0 4px;
  }
  .session-heading p,
  .session-heading > div > span {
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .session-heading h3 {
    margin: 5px 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 550;
  }
  .session-progress {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 24px;
    padding: 16px 0;
    border-block: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
  .session-progress span {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .session-progress i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
  }
  .session-numbers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 28px 24px;
  }
  .session-numbers div {
    display: grid;
    gap: 4px;
  }
  .session-numbers div + div {
    border-left: 1px solid var(--border);
    padding-left: 18px;
  }
  .session-numbers strong {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .session-numbers span {
    color: var(--text-dim);
    font-size: 0.8125rem;
  }
  .session-notice {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    margin: 0 24px 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #5689e808;
  }
  .session-notice > :global(svg) {
    flex-shrink: 0;
    color: #9eb9eb;
  }
  .session-notice > :global(svg:last-child) {
    margin-left: auto;
    color: var(--green);
  }
  @media (max-width: 900px) {
    .workflow,
    .workflow--reverse {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .workflow--reverse .story-copy {
      order: 0;
    }
    .section-copy {
      max-width: 58ch;
    }
  }
  @media (max-width: 480px) {
    .panel-bar,
    .promotion-person,
    .session-heading {
      padding: 18px 16px;
    }
    .promotion-steps {
      padding-inline: 16px;
    }
    .panel-bar {
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .session-progress {
      margin-inline: 16px;
      flex-wrap: wrap;
    }
    .session-numbers {
      padding: 22px 16px;
    }
    .session-numbers div + div {
      padding-left: 10px;
    }
    .session-notice {
      margin-inline: 16px;
    }
    .panel-foot {
      padding-inline: 16px;
    }
  }
</style>
