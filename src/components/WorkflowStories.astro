---
import DiscordCommandPreview from './DiscordCommandPreview.astro';
import Icon from './Icon.astro';
import CommunityMesh from './CommunityMesh.astro';
import ScoutShowcase from './ScoutShowcase.astro';
---

<section
  class="section workflows"
  id="workflows"
  aria-label="Community workflows"
>
  <div class="container">
    <article class="workflow" data-observe-reveal>
      <div class="story-copy">
        <p class="eyebrow">01 / Discord commands</p>
        <h2 class="display section-title">
          Take action.
          <br />
          Stay in Discord.
        </h2>
        <p class="section-copy">
          Run a command where your staff already work. Rodyne handles the
          action, confirms the result and keeps the log one click away.
        </p>
        <ul class="benefits">
          <li>
            <Icon name="check" size={16} />
            Moderate connected experiences from Discord
          </li>
          <li>
            <Icon name="check" size={16} />
            Keep commands limited to authorised staff
          </li>
          <li>
            <Icon name="check" size={16} />
            See the result and open the action log
          </li>
        </ul>
        <a class="text-link" href="#security">
          Stay in control <Icon name="arrow" size={16} />
        </a>
      </div>
      <DiscordCommandPreview />
    </article>

    <CommunityMesh />

    <ScoutShowcase />
  </div>
</section>

<style>
  .workflows {
    padding-bottom: 0;
  }
  .workflow {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 7vw, 100px);
    align-items: center;
    padding-bottom: clamp(80px, 10vw, 132px);
  }
  .section-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.1;
  }
  .section-copy {
    max-width: 42ch;
    font-size: 1rem;
  }
  .benefits {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 26px;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .benefits li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .benefits :global(svg) {
    flex-shrink: 0;
    color: #9eb9eb;
  }
  .text-link {
    margin-top: 20px;
  }
  @media (max-width: 900px) {
    .workflow {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .section-copy {
      max-width: 58ch;
    }
  }
</style>
