---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';

interface Props {
  brandLabel?: string;
}

const { brandLabel = site.name } = Astro.props;
---

<header class="site-header" data-header>
  <div class="header-shell">
    <a class="brand" href={site.links.home} aria-label={`${brandLabel} home`}>
      <BrandMark />
      <span>{brandLabel}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      {site.appReady && (
        <a class="sign-in" href={site.links.signIn}>
          Sign in
        </a>
      )}
      <a class="button button--primary choose-plan" href={site.links.pricing}>
        View pricing
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
        >
          <span>{item.label}</span>
          <Icon name="arrow" size={17} />
        </a>
      ))}
      {site.appReady && (
        <a href={site.links.signIn}>
          <span>Sign in</span>
          <Icon name="arrow" size={17} />
        </a>
      )}
      <a class="button button--primary" href={site.links.pricing}>
        View pricing
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    backdrop-filter: blur(18px);
    transition:
      border-color 320ms ease,
      background-color 320ms ease,
      box-shadow 320ms ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
    background-color: color-mix(in srgb, var(--bg) 92%, transparent);
    box-shadow: 0 8px 28px -18px #0009;
  }

  .header-shell {
    width: min(100%, calc(var(--content-width) + var(--page-gutter) * 2));
    min-height: var(--header-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 0.96rem;
    font-weight: 680;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .desktop-nav a,
  .sign-in {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding-inline: 11px;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 520;
    letter-spacing: -0.01em;
    transition: color 180ms ease;
  }

  .desktop-nav a {
    position: relative;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    inset: auto 11px 6px;
    height: 1px;
    background: #9db9ed;
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
    transition:
      transform 280ms var(--ease-soft),
      opacity 220ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
    opacity: 0.65;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'],
  .mobile-menu a[aria-current='page'],
  .sign-in:hover {
    color: var(--text);
  }

  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 7px;
  }

  .choose-plan {
    min-height: 38px;
    padding: 8px 14px;
    font-size: 0.8rem;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    display: none;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.025);
    cursor: pointer;
  }

  .menu-toggle span {
    position: absolute;
    width: 17px;
    height: 1px;
    border-radius: 1px;
    background: var(--text);
    transition: transform 220ms ease;
  }

  .menu-toggle span:first-child {
    transform: translateY(-3px);
  }

  .menu-toggle span:last-child {
    transform: translateY(3px);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    z-index: -1;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    left: 0;
    padding: 14px var(--page-gutter) max(24px, env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(18px);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-menu nav > a:not(.button) {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .mobile-menu .button {
    margin-top: 16px;
  }

  @media (max-width: 1080px) {
    .header-shell {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 820px) {
    .header-shell {
      gap: 10px;
    }

    .sign-in,
    .choose-plan {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span,
    .site-header {
      transition: none;
    }
  }
</style>
