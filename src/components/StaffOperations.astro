---
import Icon from './Icon.astro';
const shifts = [
  {
    name: 'MiraNorth',
    initials: 'MN',
    role: 'Training host',
    status: 'On shift',
    time: '01:42',
    tone: 'green',
  },
  {
    name: 'NoahField',
    initials: 'NF',
    role: 'Moderator',
    status: 'On break',
    time: '00:48',
    tone: 'amber',
  },
  {
    name: 'LenaShores',
    initials: 'LS',
    role: 'Supervisor',
    status: 'Clocked out',
    time: '02:15',
    tone: 'muted',
  },
];
---

<section class="section staff-section" id="staff" aria-labelledby="staff-title">
  <div class="container staff-layout" data-observe-reveal>
    <div class="story-copy">
      <p class="eyebrow">04 / Staff and shifts</p>
      <h2 class="display section-title" id="staff-title">
        A little less admin.
        <br />A lot more teamwork.
      </h2>
      <p class="section-copy">
        Know who’s on shift, what they’re working on and when they need a break.
        Give your team one place for the everyday work behind your community.
      </p>
      <ul class="benefits">
        <li>
          <Icon name="check" size={16} />
          Clock in, take a break and clock out
        </li>
        <li>
          <Icon name="check" size={16} />
          Review timesheets, activity and weekly targets
        </li>
        <li>
          <Icon name="check" size={16} />
          Manage time off, assignments and staff logbooks
        </li>
      </ul>
      <a class="text-link" href="#modules">
        Explore every staff tool <Icon name="arrow" size={16} />
      </a>
    </div>
    <div
      class="staff-panel panel"
      aria-label="Sample staff shifts and timesheet"
    >
      <div class="panel-bar">
        <span>
          <Icon name="clock" size={16} />
          Staff activity
        </span>
        <small>Sample data</small>
      </div>
      <div class="shift-current">
        <div class="shift-heading">
          <span class="avatar">MN</span>
          <div>
            <strong>MiraNorth</strong>
            <p>Training host · Northwind City</p>
          </div>
          <span class="live-status">On shift</span>
        </div>
        <div class="shift-timer">
          <div>
            <span class="timer-label">Current shift</span>
            <strong class="mono">
              01:42<span>:08</span>
            </strong>
          </div>
          <div class="shift-actions" aria-label="Example shift controls">
            <span>Take a break</span>
            <span class="clock-out">
              <Icon name="clock" size={14} />
              Clock out
            </span>
          </div>
        </div>
        <div class="shift-start">
          <Icon name="check" size={13} />
          Clocked in at 16:18 UTC <span>Time recorded automatically</span>
        </div>
      </div>
      <div class="roster-heading">
        <h3>Your team today</h3>
        <span>3 staff</span>
      </div>
      <ul class="roster">
        {shifts.map((shift) => (
          <li>
            <span class="avatar avatar--small">{shift.initials}</span>
            <div class="staff-person">
              <strong>{shift.name}</strong>
              <small>{shift.role}</small>
            </div>
            <span class:list={['shift-status', shift.tone]}>
              {shift.status}
            </span>
            <time class="mono">{shift.time}</time>
          </li>
        ))}
      </ul>
      <div class="staff-bottom">
        <div class="timesheet">
          <div class="card-label">
            <Icon name="clock" size={14} />
            Weekly timesheet
          </div>
          <p>
            <strong>8h 30m</strong>
            <span>of 10h target</span>
          </p>
          <div
            class="activity-track"
            role="meter"
            aria-label="Weekly activity target"
            aria-valuemin={0}
            aria-valuemax={10}
            aria-valuenow={8.5}
          >
            <i></i>
          </div>
          <small>Shifts and breaks, all accounted for.</small>
        </div>
        <div class="time-off">
          <div class="card-label">
            <Icon name="calendar" size={14} />
            Time off
          </div>
          <p>
            <strong>LenaShores</strong>
            <span>14–16 September</span>
          </p>
          <span class="approved">
            <Icon name="check" size={13} />
            Approved by MiraNorth
          </span>
        </div>
      </div>
      <div class="panel-foot">
        <Icon name="note" size={14} />
        Shift history stays on each staff profile.
      </div>
    </div>
  </div>
</section>

<style>
  .staff-section {
    padding-top: 0;
  }
  .staff-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(36px, 7vw, 100px);
  }
  .section-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.1;
  }
  .section-copy {
    max-width: 43ch;
    font-size: 1rem;
  }
  .benefits {
    display: grid;
    gap: 12px;
    margin-top: 26px;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
  .benefits li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .benefits :global(svg) {
    flex-shrink: 0;
    color: #9eb9eb;
  }
  .text-link {
    margin-top: 22px;
  }
  .staff-panel {
    min-width: 0;
    overflow: hidden;
    background: linear-gradient(140deg, #5689e809, transparent 55%), #101115;
    font-size: 0.8125rem;
  }
  .panel-bar,
  .panel-bar > span,
  .shift-heading,
  .shift-timer,
  .shift-start,
  .roster-heading,
  .roster li,
  .card-label,
  .approved,
  .panel-foot {
    display: flex;
    align-items: center;
  }
  .panel-bar {
    justify-content: space-between;
    gap: 12px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
  }
  .panel-bar > span,
  .card-label,
  .approved,
  .panel-foot {
    gap: 8px;
  }
  .panel-bar small,
  .timer-label,
  .shift-start,
  .roster-heading > span,
  .staff-person small,
  .staff-bottom small,
  .panel-foot {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .shift-current {
    margin: 24px;
    padding: 18px;
    border: 1px solid #9eb9eb24;
    border-radius: 9px;
    background: #9eb9eb05;
  }
  .shift-heading {
    gap: 10px;
    flex-wrap: wrap;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #93b8f51c;
    color: #adc5ed;
    font-size: 0.6875rem;
  }
  .shift-heading strong,
  .staff-person strong {
    font-weight: 550;
  }
  .shift-heading p {
    color: var(--text-dim);
    margin-top: 3px;
    font-size: 0.75rem;
  }
  .live-status {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--green);
    border: 1px solid #79c79e30;
    padding: 4px 7px;
    border-radius: 5px;
  }
  .shift-timer {
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
  }
  .timer-label {
    display: block;
    margin-bottom: 7px;
  }
  .shift-timer strong {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 450;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .shift-timer strong span {
    color: var(--text-dim);
  }
  .shift-actions {
    display: flex;
    gap: 7px;
    font-size: 0.6875rem;
  }
  .shift-actions > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text-secondary);
  }
  .shift-actions .clock-out {
    background: #e3e8f0;
    color: #17191e;
  }
  .shift-start {
    gap: 6px;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 14px;
    margin-top: 19px;
    font-size: 0.625rem;
  }
  .shift-start > span {
    margin-left: auto;
  }
  .shift-start :global(svg) {
    color: var(--green);
  }
  .roster-heading {
    justify-content: space-between;
    padding: 0 24px 12px;
  }
  .roster-heading h3 {
    font-size: 0.8125rem;
    font-weight: 550;
  }
  .roster {
    padding: 0 24px;
    list-style: none;
  }
  .roster li {
    gap: 10px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }
  .avatar--small {
    width: 28px;
    height: 28px;
    font-size: 0.625rem;
  }
  .staff-person {
    display: grid;
    gap: 3px;
  }
  .shift-status {
    margin-left: auto;
    font-size: 0.6875rem;
  }
  .green,
  .approved {
    color: var(--green);
  }
  .amber {
    color: var(--amber);
  }
  .muted {
    color: var(--text-dim);
  }
  .roster time {
    min-width: 40px;
    text-align: right;
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }
  .staff-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px 24px 24px;
  }
  .staff-bottom > div {
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 7px;
  }
  .card-label {
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }
  .staff-bottom p {
    display: grid;
    gap: 4px;
    margin-top: 14px;
  }
  .staff-bottom p strong {
    font-size: 1rem;
    font-weight: 500;
  }
  .staff-bottom p span,
  .approved,
  .staff-bottom small {
    font-size: 0.625rem;
    color: var(--text-dim);
  }
  .activity-track {
    height: 4px;
    background: #ffffff0b;
    border-radius: 4px;
    margin: 12px 0 7px;
    overflow: hidden;
  }
  .activity-track i {
    display: block;
    height: 100%;
    width: 85%;
    background: #9eb9eb;
  }
  .approved {
    margin-top: 16px;
    color: var(--green);
  }
  .panel-foot {
    border-top: 1px solid var(--border);
    padding: 14px 24px;
  }
  @media (max-width: 900px) {
    .staff-layout {
      grid-template-columns: 1fr;
    }
    .section-copy {
      max-width: 58ch;
    }
  }
  @media (max-width: 480px) {
    .panel-bar,
    .panel-foot {
      padding-inline: 16px;
    }
    .shift-current {
      margin: 16px;
      padding: 14px;
    }
    .roster,
    .roster-heading {
      padding-inline: 16px;
    }
    .staff-bottom {
      padding: 12px 16px 16px;
      grid-template-columns: 1fr;
    }
    .shift-start > span {
      margin-left: 0;
    }
    .roster li {
      gap: 7px;
    }
  }
</style>
