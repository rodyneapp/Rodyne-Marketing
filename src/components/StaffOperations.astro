---
import Icon from './Icon.astro';
const week = [
  { day: 'Mon', time: '1h 30m', height: 60 },
  { day: 'Tue', time: '2h', height: 80 },
  { day: 'Wed', time: '1h 45m', height: 70 },
  { day: 'Thu', time: '1h 45m', height: 70 },
  { day: 'Fri', time: '1h 30m 06s', height: 60 },
  { day: 'Sat', time: '0h', height: 0 },
  { day: 'Sun', time: '0h', height: 0 },
];
---

<section class="section staff-section" id="staff" aria-labelledby="staff-title">
  <div class="container staff-layout" data-observe-reveal>
    <div class="story-copy">
      <p class="eyebrow">04 / Staff and shifts</p>
      <h2 class="display section-title" id="staff-title">
        A little less admin.
        <br />A lot more teamwork.
      </h2>
      <p class="section-copy">
        Know who’s on shift, what they’re working on and when they need a break.
        Give your team one place for the everyday work behind your community.
      </p>
      <ul class="benefits">
        <li>
          <Icon name="check" size={16} />
          Clock in, take a break and clock out
        </li>
        <li>
          <Icon name="check" size={16} />
          Review timesheets, activity and weekly targets
        </li>
        <li>
          <Icon name="check" size={16} />
          Manage time off, assignments and staff logbooks
        </li>
      </ul>
      <a class="text-link" href="#modules">
        Explore every staff tool <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="shift-demo panel" data-continuous-motion data-shift-demo>
      <div class="demo-heading">
        <span>
          <Icon name="clock" size={16} /> Your shift
        </span>
        <span class="demo-meta">
          Preview
          <button
            type="button"
            class="motion-toggle"
            data-shift-pause
            aria-label="Pause shift animation"
            aria-pressed="false"
          >
            Pause
          </button>
        </span>
      </div>
      <div class="shift-animation" data-phase="ready">
        <div class="shift-person">
          <span class="avatar">MN</span>
          <div>
            <strong>MiraNorth</strong>
            <p>Training host</p>
          </div>
        </div>
        <p class="sr-only">
          Animated example: a cursor clicks the round clock to start, waits six
          seconds, clicks it again to stop, then selects End shift to show the
          weekly timesheet.
        </p>
        <div class="demo-scene" aria-hidden="true">
          <div class="clock-screen">
            <div class="clock-scene">
              <svg class="clock-ring" viewBox="0 0 240 240" fill="none">
                <circle class="ring-track" cx="120" cy="120" r="110" />
                <circle
                  class="ring-progress"
                  cx="120"
                  cy="120"
                  r="110"
                  pathLength="100"
                />
              </svg>
              <div class="clock-content">
                <span class="stage-status" data-clock-status>
                  Ready when you are
                </span>
                <span class="timer mono">
                  00:00<span data-clock-seconds>:00</span>
                </span>
                <span class="round-action" data-clock-action>
                  Click to start
                </span>
              </div>
            </div>
            <div class="end-shift">
              <Icon name="check" size={15} /> End shift
            </div>
            <p class="shift-hint" data-clock-hint>
              Your time starts with a click.
            </p>
          </div>
          <div class="weekly-screen">
            <div class="weekly-heading">
              <span>This week</span>
              <span class="saved">
                <Icon name="check" size={13} /> Shift saved
              </span>
            </div>
            <p class="weekly-total mono">
              08<span>h</span> 30<span>m</span> <small>06s</small>
            </p>
            <p class="weekly-caption">of your 10 hour weekly target</p>
            <div class="week-chart">
              {week.map((day) => (
                <div
                  class:list={['week-day', { today: day.day === 'Fri' }]}
                  title={`${day.day}: ${day.time}`}
                >
                  <div class="bar-track">
                    <i style={`--bar-height: ${day.height}%`}></i>
                  </div>
                  <span>{day.day}</span>
                </div>
              ))}
            </div>
            <div class="saved-shift">
              <span>Latest shift</span>
              <strong class="mono">00:00:06</strong>
              <span class="saved">Recorded</span>
            </div>
          </div>
          <div class="demo-cursor">
            <span class="click-ripple"></span>
            <svg width="25" height="30" viewBox="0 0 25 30" fill="none">
              <path
                d="M3 2L3 23L8.5 18.5L13 28L17 26L12.5 17L20 16L3 2Z"
                fill="#fafafa"
                stroke="#101115"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
            </svg>
          </div>
        </div>
      </div>
      <div class="demo-footer">
        <Icon name="check" size={14} /> Time tracked. Team in sync.
      </div>
    </div>
  </div>
</section>

<style>
  .staff-section {
    padding-top: 0;
  }
  .staff-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(36px, 7vw, 100px);
  }
  .section-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.1;
  }
  .section-copy {
    max-width: 43ch;
    font-size: 1rem;
  }
  .benefits {
    display: grid;
    gap: 12px;
    margin-top: 26px;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
  .benefits li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .benefits :global(svg) {
    flex-shrink: 0;
    color: #9eb9eb;
  }
  .text-link {
    margin-top: 22px;
  }
  .shift-demo {
    min-width: 0;
    overflow: hidden;
    background: #101115;
    --motion-state: paused;
  }
  .demo-heading,
  .demo-heading > span,
  .demo-footer {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .demo-heading {
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
  }
  .demo-meta {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .motion-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 5px 9px;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.75rem;
  }
  .motion-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .motion-toggle:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .shift-animation {
    padding: 28px 24px 26px;
  }
  .shift-person {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-secondary);
    font-size: 0.6875rem;
  }
  .shift-person strong {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .shift-person p {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .demo-scene {
    position: relative;
    height: 350px;
    margin-top: 18px;
  }
  .clock-screen,
  .weekly-screen {
    position: absolute;
    inset: 0;
    transition:
      opacity 450ms ease,
      transform 450ms ease;
  }
  .clock-scene {
    position: relative;
    width: 240px;
    height: 240px;
    margin: 0 auto;
    border-radius: 50%;
    background: #ffffff02;
    transform: scale(var(--clock-scale, 1));
  }
  .clock-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .ring-track {
    stroke: #ffffff0b;
    stroke-width: 5;
  }
  .ring-progress {
    stroke: #adc5ed;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: var(--ring-offset, 100);
  }
  .clock-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 17px;
  }
  .stage-status {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .timer {
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .timer > span {
    color: var(--text-dim);
  }
  .round-action {
    font-size: 0.75rem;
    color: #adc5ed;
  }
  .end-shift {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 132px;
    height: 40px;
    margin: 18px auto 0;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    background: #ffffff05;
    color: var(--text-dim);
    font-size: 0.8125rem;
    transform: scale(var(--end-scale, 1));
  }
  [data-phase='stopped'] .end-shift {
    background: #e3e8f0;
    color: #17191e;
  }
  .shift-hint {
    text-align: center;
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .demo-cursor {
    position: absolute;
    left: 50%;
    top: 0;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    filter: drop-shadow(0 2px 3px #0006);
  }
  .click-ripple {
    position: absolute;
    left: 3px;
    top: 2px;
    width: 30px;
    height: 30px;
    margin: -15px;
    border: 1px solid #dce6f5;
    border-radius: 50%;
    opacity: var(--click-opacity, 0);
    transform: scale(var(--click-scale, 0.2));
  }
  .weekly-screen {
    opacity: 0;
    transform: translateY(8px);
    padding: 20px 8px 0;
  }
  [data-phase='weekly'] .clock-screen {
    opacity: 0;
    transform: translateY(-8px);
  }
  [data-phase='weekly'] .weekly-screen {
    opacity: 1;
    transform: translateY(0);
  }
  .weekly-heading,
  .saved,
  .saved-shift {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .weekly-heading {
    justify-content: space-between;
    font-size: 0.875rem;
  }
  .saved {
    color: var(--green);
    font-size: 0.75rem;
  }
  .weekly-total {
    margin-top: 22px;
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    letter-spacing: -0.06em;
    line-height: 1.2;
  }
  .weekly-total > span,
  .weekly-total small {
    font-size: 0.875rem;
    color: var(--text-dim);
    letter-spacing: 0;
  }
  .weekly-caption {
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .week-chart {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
    margin-top: 22px;
  }
  .week-day {
    text-align: center;
    font-size: 0.6875rem;
    color: var(--text-dim);
  }
  .bar-track {
    height: 85px;
    display: flex;
    align-items: end;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .bar-track i {
    display: block;
    width: 100%;
    height: max(3px, var(--bar-height));
    background: #adc5ed35;
    border-radius: 3px 3px 0 0;
  }
  .today .bar-track i {
    background: #adc5ed;
  }
  .today {
    color: var(--text);
  }
  .saved-shift {
    justify-content: space-between;
    border-top: 1px solid var(--border);
    margin-top: 20px;
    padding-top: 15px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .saved-shift strong {
    color: var(--text-secondary);
    font-weight: 400;
  }
  .demo-footer {
    justify-content: center;
    border-top: 1px solid var(--border);
    padding: 15px 20px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .demo-footer :global(svg) {
    color: var(--green);
  }
  @media (max-width: 900px) {
    .staff-layout {
      grid-template-columns: 1fr;
    }
    .section-copy {
      max-width: 58ch;
    }
    .shift-demo {
      width: 100%;
      max-width: 600px;
      justify-self: center;
    }
  }
  @media (max-width: 480px) {
    .demo-heading {
      padding-inline: 16px;
    }
    .shift-animation {
      padding-inline: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clock-screen,
    .weekly-screen {
      transition: none;
    }
    .motion-toggle {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/shift-demo';
</script>
