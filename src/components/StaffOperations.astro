---
import Icon from './Icon.astro';
const stages = [
  {
    label: 'Clock in',
    status: 'Ready when you are',
    time: '00:00',
    seconds: '00',
    note: 'A fresh start.',
    icon: 'clock',
  },
  {
    label: 'On shift',
    status: 'On shift',
    time: '01:42',
    seconds: '08',
    note: 'Every minute, accounted for.',
    icon: 'clock',
  },
  {
    label: 'On break',
    status: 'Take a moment',
    time: '01:42',
    seconds: '08',
    note: 'Your shift timer is paused.',
    icon: 'clock',
  },
  {
    label: 'Clock out',
    status: 'Shift saved',
    time: '02:15',
    seconds: '00',
    note: 'Added to your timesheet.',
    icon: 'check',
  },
];
---

<section class="section staff-section" id="staff" aria-labelledby="staff-title">
  <div class="container staff-layout" data-observe-reveal>
    <div class="story-copy">
      <p class="eyebrow">04 / Staff and shifts</p>
      <h2 class="display section-title" id="staff-title">
        A little less admin.
        <br />A lot more teamwork.
      </h2>
      <p class="section-copy">
        Know who’s on shift, what they’re working on and when they need a break.
        Give your team one place for the everyday work behind your community.
      </p>
      <ul class="benefits">
        <li>
          <Icon name="check" size={16} />
          Clock in, take a break and clock out
        </li>
        <li>
          <Icon name="check" size={16} />
          Review timesheets, activity and weekly targets
        </li>
        <li>
          <Icon name="check" size={16} />
          Manage time off, assignments and staff logbooks
        </li>
      </ul>
      <a class="text-link" href="#modules">
        Explore every staff tool <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="shift-demo panel" data-continuous-motion data-shift-demo>
      <div class="demo-heading">
        <span>
          <Icon name="clock" size={16} /> Your shift
        </span>
        <span class="demo-meta">
          Preview
          <button
            type="button"
            class="motion-toggle"
            data-shift-pause
            aria-label="Pause shift animation"
            aria-pressed="false"
          >
            Pause
          </button>
        </span>
      </div>
      <div class="shift-animation">
        <div class="shift-person">
          <span class="avatar">MN</span>
          <div>
            <strong>MiraNorth</strong>
            <p>Training host</p>
          </div>
        </div>
        <p class="sr-only">
          Example shift: clock in, track working time, pause for a break, then
          clock out. Your completed shift is saved to your timesheet.
        </p>
        <div class="clock-scene" aria-hidden="true">
          <svg class="clock-ring" viewBox="0 0 240 240" fill="none">
            <circle class="ring-track" cx="120" cy="120" r="110" />
            <circle
              class="ring-progress"
              cx="120"
              cy="120"
              r="110"
              pathLength="100"
            />
          </svg>
          <div class="clock-stages">
            {stages.map((stage, index) => (
              <div
                class:list={['clock-stage', { 'default-stage': index === 1 }]}
                style={`--stage-delay: ${-((4 - index) % 4) * 4}s`}
              >
                <span class="stage-status">
                  <Icon name={stage.icon} size={14} />
                  {stage.status}
                </span>
                <span class="timer mono">
                  {stage.time}
                  <span>:{stage.seconds}</span>
                </span>
                <span class="timer-caption">
                  {index === 3
                    ? 'Total shift time'
                    : 'Hours / minutes / seconds'}
                </span>
              </div>
            ))}
          </div>
        </div>
        <div class="shift-notes" aria-hidden="true">
          {stages.map((stage, index) => (
            <p
              class:list={['clock-stage', { 'default-stage': index === 1 }]}
              style={`--stage-delay: ${-((4 - index) % 4) * 4}s`}
            >
              {stage.note}
            </p>
          ))}
        </div>
        <ol class="shift-steps" aria-label="Shift workflow">
          {stages.map((stage, index) => (
            <li style={`--stage-delay: ${-((4 - index) % 4) * 4}s`}>
              <span class="step-mark" aria-hidden="true">
                <i></i>
              </span>
              {stage.label}
            </li>
          ))}
        </ol>
      </div>
      <div class="demo-footer">
        <Icon name="check" size={14} /> Time tracked. Team in sync.
      </div>
    </div>
  </div>
</section>

<style>
  .staff-section {
    padding-top: 0;
  }
  .staff-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(36px, 7vw, 100px);
  }
  .section-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.1;
  }
  .section-copy {
    max-width: 43ch;
    font-size: 1rem;
  }
  .benefits {
    display: grid;
    gap: 12px;
    margin-top: 26px;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
  .benefits li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .benefits :global(svg) {
    flex-shrink: 0;
    color: #9eb9eb;
  }
  .text-link {
    margin-top: 22px;
  }
  .shift-demo {
    min-width: 0;
    overflow: hidden;
    background: #101115;
    --motion-state: paused;
  }
  .demo-heading,
  .demo-heading > span,
  .demo-footer {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .demo-heading {
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
  }
  .demo-meta {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .motion-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 5px 9px;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.75rem;
  }
  .motion-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .motion-toggle:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .shift-animation {
    padding: 28px 24px 26px;
  }
  .shift-person {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-secondary);
    font-size: 0.6875rem;
  }
  .shift-person strong {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .shift-person p {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .clock-scene {
    position: relative;
    width: min(100%, 258px);
    aspect-ratio: 1;
    margin: 26px auto 16px;
  }
  .clock-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .ring-track {
    stroke: #ffffff0b;
    stroke-width: 1;
  }
  .ring-progress {
    stroke: #adc5ed;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 72;
    animation: shift-ring 16s linear infinite;
  }
  .clock-stages {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .clock-stage {
    grid-area: 1 / 1;
    opacity: 0;
    animation: shift-stage 16s var(--stage-delay) linear infinite;
  }
  .clock-stages .clock-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .stage-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
  .timer {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .timer > span {
    color: var(--text-dim);
  }
  .timer-caption {
    color: var(--text-dim);
    font-size: 0.625rem;
    letter-spacing: 0.025em;
  }
  .shift-notes {
    display: grid;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    min-height: 1.6em;
  }
  .shift-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin-top: 30px;
  }
  .shift-steps li {
    position: relative;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .shift-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 5px;
    left: calc(50% + 12px);
    right: calc(-50% + 12px);
    height: 1px;
    background: var(--border);
  }
  .step-mark {
    display: grid;
    place-items: center;
    width: 11px;
    height: 11px;
    margin: 0 auto 10px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
  }
  .step-mark i {
    width: 5px;
    height: 5px;
    background: #adc5ed;
    border-radius: 50%;
    opacity: 0;
    animation: shift-stage 16s var(--stage-delay) linear infinite;
  }
  .shift-animation *,
  .shift-animation *::after {
    animation-play-state: var(--shift-play-state, var(--motion-state, paused));
  }
  .demo-footer {
    justify-content: center;
    border-top: 1px solid var(--border);
    padding: 15px 20px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .demo-footer :global(svg) {
    color: var(--green);
  }
  @keyframes shift-stage {
    0%,
    22% {
      opacity: 1;
      transform: translateY(0);
    }
    25%,
    97% {
      opacity: 0;
      transform: translateY(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes shift-ring {
    0%,
    20% {
      stroke-dashoffset: 100;
      stroke: #adc5ed;
    }
    47%,
    70% {
      stroke-dashoffset: 38;
      stroke: #adc5ed;
    }
    76%,
    94% {
      stroke-dashoffset: 0;
      stroke: var(--green);
    }
    100% {
      stroke-dashoffset: 100;
      stroke: #adc5ed;
    }
  }
  @media (max-width: 900px) {
    .staff-layout {
      grid-template-columns: 1fr;
    }
    .section-copy {
      max-width: 58ch;
    }
    .shift-demo {
      width: 100%;
      max-width: 600px;
      justify-self: center;
    }
  }
  @media (max-width: 480px) {
    .demo-heading {
      padding-inline: 16px;
    }
    .shift-animation {
      padding-inline: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shift-animation * {
      animation: none;
    }
    .clock-stage {
      opacity: 0;
    }
    .default-stage {
      opacity: 1;
    }
    .shift-steps li:nth-child(2) i {
      opacity: 1;
    }
    .motion-toggle {
      display: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-shift-demo]')
    .forEach((demo) => {
      const button =
        demo.querySelector<HTMLButtonElement>('[data-shift-pause]');
      button?.addEventListener('click', () => {
        const paused = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(paused));
        button.setAttribute(
          'aria-label',
          paused ? 'Play shift animation' : 'Pause shift animation',
        );
        button.textContent = paused ? 'Play' : 'Pause';
        if (paused) demo.style.setProperty('--shift-play-state', 'paused');
        else demo.style.removeProperty('--shift-play-state');
      });
    });
</script>
