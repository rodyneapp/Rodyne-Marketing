---
import { Image } from 'astro:assets';
import annieAvatar from '../assets/annie-fernanda.webp';
import chrxsAvatar from '../assets/chrxs-dev-avatar.webp';
import haleyAvatar from '../assets/haley-morgan.webp';
import ronaldAvatar from '../assets/ronald-ramirez.webp';
import Icon from './Icon.astro';

const cases = [
  {
    id: '#1042',
    subject: 'chrxs_dev',
    category: 'Disruptive vehicle use',
    status: 'Closed',
    tone: 'green',
    reviewer: 'MiraNorth',
    source: 'In-game report',
    updated: '20:39',
    avatar: chrxsAvatar,
    selected: true,
  },
  {
    id: '#1041',
    subject: 'Haley_morgan1',
    category: 'Support escalation',
    status: 'Waiting',
    tone: 'neutral',
    reviewer: 'NoahField',
    source: 'Discord ticket',
    updated: '19:12',
    avatar: haleyAvatar,
    selected: false,
  },
  {
    id: '#1038',
    subject: 'AnnieFernanda',
    category: 'Restriction appeal',
    status: 'Appeal open',
    tone: 'blue',
    reviewer: 'LenaShores',
    source: 'Discord appeal',
    updated: '18:48',
    avatar: annieAvatar,
    selected: false,
  },
  {
    id: '#1036',
    subject: 'RonaldRamirez73',
    category: 'Gameplay report',
    status: 'Unassigned',
    tone: 'amber',
    reviewer: 'Unassigned',
    source: 'In-game report',
    updated: '17:26',
    avatar: ronaldAvatar,
    selected: false,
  },
] as const;

const timeline = [
  {
    type: 'Allegation',
    title: 'Report received',
    detail: 'Submitted in-game with server and round references.',
    moderator: 'NoahField',
    attribution: 'Received by',
    time: '18:41',
    tone: 'neutral',
  },
  {
    type: 'Assignment',
    title: 'Reviewer assigned',
    detail: 'MiraNorth accepted the case from the staff queue.',
    moderator: 'MiraNorth',
    attribution: 'Assigned by',
    time: '18:44',
    tone: 'blue',
  },
  {
    type: 'Evidence',
    title: 'Evidence attached',
    detail: 'Two screenshots and one connector event were added.',
    moderator: 'MiraNorth',
    attribution: 'Added by',
    time: '18:49',
    tone: 'blue',
  },
  {
    type: 'Confirmed finding',
    title: 'Finding confirmed',
    detail: 'The reviewer recorded the policy finding and rationale.',
    moderator: 'MiraNorth',
    attribution: 'Confirmed by',
    time: '18:57',
    tone: 'amber',
  },
  {
    type: 'Requested action',
    title: '24-hour experience restriction requested',
    detail: 'Scope: Northwind City only · explicit expiry recorded.',
    moderator: 'MiraNorth',
    attribution: 'Requested by',
    time: '18:59',
    tone: 'amber',
  },
  {
    type: 'Executed action',
    title: 'Restriction confirmed',
    detail: 'The supported server adapter confirmed the restriction.',
    moderator: 'MiraNorth',
    attribution: 'Authorised by',
    time: '19:00',
    tone: 'green',
  },
  {
    type: 'Appeal',
    title: 'Appeal submitted',
    detail: 'The member response was attached to the same case.',
    moderator: 'LenaShores',
    attribution: 'Received by',
    time: '20:16',
    tone: 'neutral',
  },
  {
    type: 'Appeal decision',
    title: 'Appeal accepted',
    detail: 'A second reviewer recorded the reversal rationale.',
    moderator: 'LenaShores',
    attribution: 'Reviewed by',
    time: '20:38',
    tone: 'blue',
  },
  {
    type: 'Reversed action',
    title: 'Restriction reversed',
    detail: 'The adapter confirmed that experience access was restored.',
    moderator: 'LenaShores',
    attribution: 'Authorised by',
    time: '20:39',
    tone: 'green',
  },
] as const;

const phases = [
  {
    title: 'Report & evidence',
    summary: 'Report received, reviewer assigned, evidence attached',
    time: '18:41–18:49',
    events: timeline.slice(0, 3),
  },
  {
    title: 'Decision & action',
    summary: '24-hour restriction confirmed',
    time: '18:57–19:00',
    events: timeline.slice(3, 6),
  },
  {
    title: 'Appeal & resolution',
    summary: 'Appeal accepted · access restored',
    time: '20:16–20:39',
    events: timeline.slice(6),
  },
];
const outcomes = [
  {
    title: 'Access restored',
    detail: 'Appeal accepted. The experience restriction was reversed.',
    label: 'Resolved',
    tone: 'green',
  },
  {
    title: 'Awaiting a response',
    detail: 'The support escalation is with NoahField for follow-up.',
    label: 'In progress',
    tone: 'neutral',
  },
  {
    title: 'Appeal under review',
    detail: 'LenaShores is reviewing the member’s restriction appeal.',
    label: 'In progress',
    tone: 'blue',
  },
  {
    title: 'Ready for assignment',
    detail: 'This gameplay report is waiting for a staff reviewer.',
    label: 'Needs attention',
    tone: 'amber',
  },
];
---

<section
  class="section moderation-section"
  id="moderation"
  aria-labelledby="moderation-title"
>
  <div class="container">
    <div class="section-heading" data-observe-reveal>
      <p class="eyebrow">03 / Reports and resolutions</p>
      <h2 class="display section-title" id="moderation-title">
        Give every report a clear resolution.
      </h2>
      <p class="section-copy">
        From the first report to the final appeal. Give staff one clear record
        of what happened, who reviewed it, and how it was resolved.
      </p>
    </div>

    <div
      class="case-workspace panel"
      data-case-showcase
      aria-label="Interactive case showcase using demo data"
    >
      <div class="case-appbar">
        <span class="case-brand">
          <Icon name="case" size={18} />
          <strong>Case workspace</strong>
        </span>
        <span class="demo-label">Demo data</span>
      </div>
      <div class="case-layout">
        <nav class="case-inbox" aria-label="Sample cases">
          <div class="inbox-header">
            <h3>
              Cases inbox <span>04</span>
            </h3>
            <p>Select a case to explore</p>
          </div>
          <ol class="case-list">
            {cases.map((item, index) => (
              <li>
                <button
                  type="button"
                  class="case-option"
                  data-case-select={index}
                  aria-current={item.selected ? 'true' : undefined}
                  aria-controls={`case-panel-${index}`}
                  disabled
                >
                  <span class="case-row-top">
                    <span class="mono">{item.id}</span>
                    <span
                      class:list={['case-status', `case-status--${item.tone}`]}
                    >
                      <i></i>
                      {item.status}
                    </span>
                  </span>
                  <span class="case-person">
                    <Image
                      src={item.avatar}
                      alt=""
                      width={36}
                      height={36}
                      loading="lazy"
                    />
                    <span>
                      <strong>{item.subject}</strong>
                      <small>{item.category}</small>
                    </span>
                    <Icon name="chevron" size={15} />
                  </span>
                </button>
              </li>
            ))}
          </ol>
          <p class="inbox-note">
            <Icon name="shield" size={15} />
            Every decision has an owner.
          </p>
        </nav>

        <div class="case-detail-region">
          <p
            class="sr-only"
            data-case-announcement
            aria-live="polite"
            aria-atomic="true"
          ></p>
          {cases.map((item, index) => (
            <section
              class="case-detail"
              id={`case-panel-${index}`}
              data-case-panel={index}
              hidden={!item.selected}
              aria-labelledby={`case-title-${index}`}
            >
              <header class="detail-header">
                <p class="detail-kicker">
                  <span class="mono">{item.id}</span>
                  <span>{item.source}</span>
                </p>
                <h3 id={`case-title-${index}`}>{item.category}</h3>
                <div class="detail-person">
                  <Image
                    src={item.avatar}
                    alt=""
                    width={24}
                    height={24}
                    loading="lazy"
                  />
                  <span>{item.subject}</span>
                  <span class="detail-owner">Reviewer: {item.reviewer}</span>
                </div>
              </header>

              <div
                class:list={[
                  'case-outcome',
                  `case-outcome--${outcomes[index].tone}`,
                ]}
              >
                <span class="outcome-icon">
                  <Icon name={item.selected ? 'check' : 'case'} size={21} />
                </span>
                <div>
                  <p>{outcomes[index].label}</p>
                  <h4>{outcomes[index].title}</h4>
                  <span>{outcomes[index].detail}</span>
                </div>
              </div>

              {item.selected ? (
                <div class="case-history">
                  <div class="history-heading">
                    <h4>Case history</h4>
                    <span>9 events · 3 stages</span>
                  </div>
                  <div class="history-phases">
                    {phases.map((phase, phaseIndex) => (
                      <details class="history-phase">
                        <summary>
                          <span class="phase-number">0{phaseIndex + 1}</span>
                          <span class="phase-copy">
                            <strong>{phase.title}</strong>
                            <small>{phase.summary}</small>
                          </span>
                          <span class="phase-time mono">{phase.time}</span>
                          <Icon name="chevron" size={15} />
                        </summary>
                        <ol class="timeline-list">
                          {phase.events.map((event) => (
                            <li>
                              <span
                                class:list={[
                                  'timeline-marker',
                                  `timeline-marker--${event.tone}`,
                                ]}
                                aria-hidden="true"
                              ></span>
                              <div>
                                <strong>{event.title}</strong>
                                <p>{event.detail}</p>
                                <span class="moderator-byline">
                                  {event.attribution} <b>{event.moderator}</b>
                                </span>
                              </div>
                              <time class="mono">{event.time}</time>
                            </li>
                          ))}
                        </ol>
                      </details>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="case-next-step">
                  <h4>Current stage</h4>
                  <p>{outcomes[index].detail}</p>
                  <span>Last updated today at {item.updated}</span>
                </div>
              )}

              <details class="case-metadata">
                <summary>
                  Case details <Icon name="chevron" size={14} />
                </summary>
                <dl>
                  <div>
                    <dt>Assigned to</dt>
                    <dd>{item.reviewer}</dd>
                  </div>
                  <div>
                    <dt>Source</dt>
                    <dd>{item.source}</dd>
                  </div>
                  <div>
                    <dt>Last updated</dt>
                    <dd>Today, {item.updated}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>{item.status}</dd>
                  </div>
                  {item.selected && (
                    <>
                      <div>
                        <dt>Roblox ID</dt>
                        <dd class="mono">851394804</dd>
                      </div>
                      <div>
                        <dt>Discord ID</dt>
                        <dd class="mono">1192847461035827290</dd>
                      </div>
                    </>
                  )}
                </dl>
              </details>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-case-showcase]')
    .forEach((root) => {
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-case-select]'),
      );
      const panels = Array.from(
        root.querySelectorAll<HTMLElement>('[data-case-panel]'),
      );
      const announcement = root.querySelector<HTMLElement>(
        '[data-case-announcement]',
      );
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
          buttons.forEach((option) => {
            if (option === button) option.setAttribute('aria-current', 'true');
            else option.removeAttribute('aria-current');
          });
          panels.forEach((panel) => {
            panel.hidden =
              panel.dataset.casePanel !== button.dataset.caseSelect;
            if (!panel.hidden && announcement) {
              announcement.textContent = `Showing case ${panel.querySelector('.detail-kicker')?.textContent}: ${panel.querySelector('h3')?.textContent}`;
            }
          });
        });
      });
    });
</script>

<style>
  .moderation-section {
    background: var(--bg);
  }
  .case-workspace {
    overflow: hidden;
    background: #0e1015;
  }
  .case-workspace [hidden] {
    display: none;
  }
  .case-appbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    background: #101217;
  }
  .case-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .case-brand strong {
    color: #e2e5ec;
    font-weight: 550;
  }
  .case-layout {
    display: grid;
    grid-template-columns: 310px minmax(0, 1fr);
  }
  .case-inbox {
    min-width: 0;
    border-right: 1px solid var(--border);
    background: #0b0d11;
  }
  .inbox-header {
    padding: 25px 22px 18px;
  }
  .inbox-header h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .inbox-header h3 span {
    font: 0.75rem var(--mono);
    color: var(--text-dim);
  }
  .inbox-header p {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }
  .case-list {
    display: grid;
    gap: 6px;
    padding: 0 10px;
    list-style: none;
  }
  .case-option {
    display: block;
    width: 100%;
    padding: 16px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }
  .case-option:hover {
    background: #ffffff05;
  }
  .case-option[aria-current='true'] {
    background: #5689e80d;
    border-color: #5689e845;
    box-shadow: inset 2px 0 #719cef;
  }
  .case-option:disabled {
    cursor: default;
  }
  .case-option:focus-visible,
  summary:focus-visible {
    outline: 2px solid #9ebbf0;
    outline-offset: 3px;
  }
  .case-row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  .case-row-top > .mono {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .case-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #b7bac5;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .case-status i {
    height: 5px;
    width: 5px;
    border-radius: 50%;
    background: var(--text-dim);
  }
  .case-status--green i {
    background: var(--green);
  }
  .case-status--blue i {
    background: var(--blue);
  }
  .case-status--amber i {
    background: var(--amber);
  }
  .case-person {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .case-person :global(img) {
    flex-shrink: 0;
    border-radius: 8px;
    background: #20232b;
  }
  .case-person > span {
    min-width: 0;
    flex: 1;
  }
  .case-person strong,
  .case-person small {
    display: block;
    overflow-wrap: anywhere;
  }
  .case-person strong {
    font-size: 0.875rem;
    font-weight: 550;
    color: #e0e3eb;
  }
  .case-person small {
    margin-top: 2px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .case-person > :global(svg) {
    flex-shrink: 0;
    color: #64738d;
  }
  .case-option[aria-current='true'] .case-person > :global(svg) {
    color: #9ebbf0;
  }
  .inbox-note {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 23px 22px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .inbox-note :global(svg) {
    flex-shrink: 0;
  }
  .case-detail-region {
    min-width: 0;
  }
  .case-detail {
    padding: 28px 32px 20px;
  }
  .detail-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .detail-kicker .mono {
    color: #9ebbf0;
  }
  .detail-header h3 {
    margin-top: 9px;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 580;
    letter-spacing: -0.025em;
  }
  .detail-person {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 0.8125rem;
    color: #b7bac5;
  }
  .detail-person :global(img) {
    border-radius: 50%;
  }
  .detail-owner {
    margin-left: auto;
    color: var(--text-dim);
  }
  .case-outcome {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 24px;
    padding: 18px 20px;
    border: 1px solid #ffffff14;
    border-radius: 10px;
    background: #ffffff04;
    --outcome-accent: #b7bac5;
  }
  .case-outcome--green {
    --outcome-accent: #91d5ad;
    background: #68b98a09;
    border-color: #68b98a33;
  }
  .case-outcome--blue {
    --outcome-accent: #9ebbf0;
  }
  .case-outcome--amber {
    --outcome-accent: #e4bd85;
  }
  .outcome-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    height: 34px;
    width: 34px;
    border: 1px solid #ffffff12;
    border-radius: 50%;
    color: var(--outcome-accent);
  }
  .case-outcome p {
    color: var(--outcome-accent);
    font-size: 0.75rem;
  }
  .case-outcome h4 {
    margin-top: 1px;
    font-size: 1rem;
    font-weight: 580;
  }
  .case-outcome div > span {
    display: block;
    margin-top: 5px;
    color: #a9b0ba;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .case-history,
  .case-next-step {
    margin-top: 27px;
  }
  .history-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .history-heading h4,
  .case-next-step h4 {
    font-size: 0.875rem;
    font-weight: 550;
  }
  .history-heading > span {
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .history-phases {
    border-top: 1px solid var(--border);
  }
  .history-phase {
    border-bottom: 1px solid var(--border);
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .history-phase > summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
  }
  .history-phase > summary:hover .phase-copy strong {
    color: #aecafa;
  }
  .phase-number {
    display: grid;
    place-items: center;
    flex: 0 0 30px;
    height: 30px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: #a6b1c6;
    font: 0.75rem var(--mono);
  }
  .phase-copy {
    flex: 1;
    min-width: 0;
  }
  .phase-copy strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 550;
  }
  .phase-copy small {
    display: block;
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .phase-time {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  summary > :global(svg) {
    flex-shrink: 0;
    color: var(--text-dim);
    transition: transform 160ms ease;
  }
  details[open] > summary > :global(svg) {
    transform: rotate(90deg);
  }
  .timeline-list {
    margin: 0 0 18px 14px;
    padding-left: 25px;
    border-left: 1px solid var(--border-strong);
    list-style: none;
  }
  .timeline-list li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    padding: 10px 0;
  }
  .timeline-marker {
    position: absolute;
    left: -30px;
    top: 18px;
    height: 9px;
    width: 9px;
    border-radius: 50%;
    border: 2px solid var(--text-dim);
    background: #0e1015;
  }
  .timeline-marker--blue {
    border-color: var(--blue);
  }
  .timeline-marker--amber {
    border-color: var(--amber);
  }
  .timeline-marker--green {
    border-color: var(--green);
  }
  .timeline-list strong {
    font-size: 0.875rem;
    font-weight: 550;
  }
  .timeline-list p {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .moderator-byline {
    display: block;
    margin-top: 6px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .moderator-byline b {
    font-weight: 500;
    color: #b7bac5;
  }
  .timeline-list time {
    padding-top: 3px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .case-next-step {
    min-height: 220px;
  }
  .case-next-step p {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .case-next-step > span {
    display: block;
    margin-top: 12px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .case-metadata {
    margin-top: 16px;
  }
  .case-metadata summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
  .case-metadata dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding: 12px 0;
  }
  .case-metadata dt {
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .case-metadata dd {
    margin-top: 3px;
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
    color: #c6cbd6;
  }
