---
import { Image } from 'astro:assets';
import annieAvatar from '../assets/annie-fernanda.webp';
import chrxsAvatar from '../assets/chrxs-dev-avatar.webp';
import haleyAvatar from '../assets/haley-morgan.webp';
import ronaldAvatar from '../assets/ronald-ramirez.webp';
import Icon from './Icon.astro';

const cases = [
  {
    id: '#1042',
    subject: 'chrxs_dev',
    category: 'Disruptive vehicle use',
    status: 'Closed',
    tone: 'green',
    reviewer: 'MiraNorth',
    source: 'In-game report',
    updated: '20:39',
    avatar: chrxsAvatar,
    selected: true,
  },
  {
    id: '#1041',
    subject: 'Haley_morgan1',
    category: 'Support escalation',
    status: 'Waiting',
    tone: 'neutral',
    reviewer: 'NoahField',
    source: 'Discord ticket',
    updated: '19:12',
    avatar: haleyAvatar,
    selected: false,
  },
  {
    id: '#1038',
    subject: 'AnnieFernanda',
    category: 'Restriction appeal',
    status: 'Appeal open',
    tone: 'blue',
    reviewer: 'LenaShores',
    source: 'Discord appeal',
    updated: '18:48',
    avatar: annieAvatar,
    selected: false,
  },
  {
    id: '#1036',
    subject: 'RonaldRamirez73',
    category: 'Gameplay report',
    status: 'Unassigned',
    tone: 'amber',
    reviewer: 'Unassigned',
    source: 'In-game report',
    updated: '17:26',
    avatar: ronaldAvatar,
    selected: false,
  },
] as const;

const timeline = [
  {
    type: 'Allegation',
    title: 'Report received',
    detail: 'Submitted in-game with server and round references.',
    moderator: 'NoahField',
    attribution: 'Received by',
    time: '18:41',
    tone: 'neutral',
  },
  {
    type: 'Assignment',
    title: 'Reviewer assigned',
    detail: 'MiraNorth accepted the case from the staff queue.',
    moderator: 'MiraNorth',
    attribution: 'Assigned by',
    time: '18:44',
    tone: 'blue',
  },
  {
    type: 'Evidence',
    title: 'Evidence attached',
    detail: 'Two screenshots and one connector event were added.',
    moderator: 'MiraNorth',
    attribution: 'Added by',
    time: '18:49',
    tone: 'blue',
  },
  {
    type: 'Confirmed finding',
    title: 'Finding confirmed',
    detail: 'The reviewer recorded the policy finding and rationale.',
    moderator: 'MiraNorth',
    attribution: 'Confirmed by',
    time: '18:57',
    tone: 'amber',
  },
  {
    type: 'Requested action',
    title: '24-hour experience restriction requested',
    detail: 'Scope: Northwind City only · explicit expiry recorded.',
    moderator: 'MiraNorth',
    attribution: 'Requested by',
    time: '18:59',
    tone: 'amber',
  },
  {
    type: 'Executed action',
    title: 'Restriction confirmed',
    detail: 'The supported server adapter confirmed the restriction.',
    moderator: 'MiraNorth',
    attribution: 'Authorised by',
    time: '19:00',
    tone: 'green',
  },
  {
    type: 'Appeal',
    title: 'Appeal submitted',
    detail: 'The member response was attached to the same case.',
    moderator: 'LenaShores',
    attribution: 'Received by',
    time: '20:16',
    tone: 'neutral',
  },
  {
    type: 'Appeal decision',
    title: 'Appeal accepted',
    detail: 'A second reviewer recorded the reversal rationale.',
    moderator: 'LenaShores',
    attribution: 'Reviewed by',
    time: '20:38',
    tone: 'blue',
  },
  {
    type: 'Reversed action',
    title: 'Restriction reversed',
    detail: 'The adapter confirmed that experience access was restored.',
    moderator: 'LenaShores',
    attribution: 'Authorised by',
    time: '20:39',
    tone: 'green',
  },
] as const;
---

<section
  class="section moderation-section"
  id="moderation"
  aria-labelledby="moderation-title"
>
  <div class="container">
    <div class="section-heading" data-observe-reveal>
      <p class="eyebrow">03 / Reports and resolutions</p>
      <h2 class="display section-title" id="moderation-title">
        Give every report a clear resolution.
      </h2>
      <p class="section-copy">
        Give your staff the full story. Keep reports, evidence and appeals in
        one case inbox, with the responsible moderator recorded on every action.
      </p>
    </div>

    <div
      class="case-workspace panel"
      data-case-timeline
      aria-label="Sample cases inbox and selected member history using demo data"
    >
      <div class="case-appbar">
        <div class="case-breadcrumb">
          <Icon name="case" size={15} />
          <span>Cases</span>
          <i>/</i>
          <strong>All cases</strong>
        </div>
        <div class="case-appbar-actions">
          <span class="case-search">
            <Icon name="search" size={13} />
            Search cases <kbd>⌘ K</kbd>
          </span>
          <span class="demo-label">Demo data</span>
        </div>
      </div>

      <div class="case-layout">
        <section class="case-inbox" aria-labelledby="case-inbox-title">
          <header class="inbox-header">
            <div>
              <h3 id="case-inbox-title">Cases inbox</h3>
              <p>4 open and recently resolved cases</p>
            </div>
            <span class="square-control" aria-hidden="true">
              <Icon name="filter" size={15} />
            </span>
          </header>

          <div class="case-filters" aria-label="Case type filters">
            <span class="active">
              Player reports <b>2</b>
            </span>
            <span>
              Automated flags <b>1</b>
            </span>
            <span>
              Appeals <b>1</b>
            </span>
          </div>

          <ol class="case-list">
            {cases.map((item) => (
              <li class:list={{ selected: item.selected }}>
                <div class="case-row-top">
                  <span class="mono case-id">{item.id}</span>
                  <span
                    class:list={['case-status', `case-status--${item.tone}`]}
                  >
                    <i></i>
                    {item.status}
                  </span>
                  <time class="mono">{item.updated}</time>
                </div>

                <div class="case-person">
                  <Image
                    src={item.avatar}
                    alt=""
                    width={32}
                    height={32}
                    loading="lazy"
                  />
                  <span>
                    <strong>{item.subject}</strong>
                    <small>{item.category}</small>
                  </span>
                </div>

                <div class="case-row-meta">
                  <span>
                    <small>Assigned</small>
                    {item.reviewer}
                  </span>
                  <span>
                    <small>Source</small>
                    {item.source}
                  </span>
                </div>
              </li>
            ))}
          </ol>

          <p class="inbox-note">
            <Icon name="note" size={13} />
            Automated flags come only from owner-configured connector rules.
          </p>
        </section>

        <section class="case-detail" aria-labelledby="case-detail-title">
          <header class="detail-header">
            <div>
              <p>
                <span class="mono">#1042</span>
                <i>Player report</i>
              </p>
              <h3 id="case-detail-title">Disruptive vehicle use</h3>
            </div>
            <span class="case-status case-status--green">
              <i></i>Closed
            </span>
          </header>

          <div class="member-summary">
            <div class="summary-identity">
              <Image
                src={chrxsAvatar}
                alt="Roblox avatar for chrxs_dev"
                width={42}
                height={42}
                loading="lazy"
              />
              <span>
                <strong>chrxs_dev</strong>
                <small class="mono platform-ids">
                  <span>
                    <Icon name="roblox" size={12} />
                    <span class="sr-only">Roblox ID </span>851394804
                  </span>
                  <span>
                    <Icon name="discord" size={13} />
                    <span class="sr-only">Discord ID </span>1192847461035827290
                  </span>
                </small>
              </span>
            </div>
            <dl>
              <div>
                <dt>Assigned to</dt>
                <dd>MiraNorth</dd>
              </div>
              <div>
                <dt>Source</dt>
                <dd>In-game report</dd>
              </div>
              <div>
                <dt>Opened</dt>
                <dd>Today, 18:41</dd>
              </div>
              <div>
                <dt>Final outcome</dt>
                <dd>Restriction reversed</dd>
              </div>
            </dl>
          </div>

          <div class="detail-tabs" aria-label="Selected case sections">
            <span class="active">
              Timeline <b>9</b>
            </span>
            <span>
              Evidence <b>3</b>
            </span>
            <span>
              Private notes <b>2</b>
            </span>
          </div>

          <div class="timeline-panel">
            <div class="timeline-toolbar">
              <div>
                <h4>Member timeline</h4>
                <p>Decision, outcome and appeal in one record</p>
              </div>
              <span>
                All activity <Icon name="chevron" size={12} />
              </span>
            </div>

            <ol class="timeline-list">
              {timeline.map((event, index) => (
                <li style={`--timeline-delay: ${index * 55}ms`}>
                  <span
                    class:list={[
                      'timeline-marker',
                      `timeline-marker--${event.tone}`,
                    ]}
                    aria-hidden="true"
                  >
                    <i></i>
                  </span>
                  <div class="timeline-content">
                    <div>
                      <strong>{event.title}</strong>
                      <span>{event.type}</span>
                    </div>
                    <p>{event.detail}</p>
                    <p class="moderator-byline">
                      <Icon name="shield" size={12} />
                      {event.attribution} <b>{event.moderator}</b>
                      <em>Moderator</em>
                    </p>
                  </div>
                  <time class="mono">{event.time}</time>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .moderation-section {
    background:
      radial-gradient(
        circle at 78% 48%,
        rgba(86, 137, 232, 0.04),
        transparent 31%
      ),
      var(--bg);
  }

  .case-workspace {
    overflow: hidden;
    background: #0b0c0f;
  }

  .case-appbar {
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 15px;
    border-bottom: 1px solid var(--border);
    background: #0d0e12;
  }

  .case-breadcrumb,
  .case-appbar-actions,
  .case-search,
  .case-row-top,
  .case-person,
  .case-status,
  .summary-identity,
  .detail-header p,
  .timeline-toolbar > span {
    display: flex;
    align-items: center;
  }

  .case-breadcrumb {
    gap: 8px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .case-breadcrumb i,
  .detail-header p i {
    color: var(--text-faint);
    font-style: normal;
  }

  .case-breadcrumb strong {
    color: var(--text-secondary);
    font-weight: 570;
  }

  .case-appbar-actions {
    gap: 9px;
  }

  .case-search {
    min-width: 164px;
    min-height: 29px;
    gap: 7px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .case-search kbd {
    margin-left: auto;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .case-layout {
    display: grid;
    grid-template-columns: minmax(330px, 0.72fr) minmax(0, 1.28fr);
    min-height: 810px;
  }

  .case-inbox {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    background: #0c0d11;
  }

  .inbox-header,
  .detail-header,
  .timeline-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .inbox-header {
    min-height: 76px;
    padding: 14px 16px;
  }

  .inbox-header h3,
  .detail-header h3 {
    font-size: 0.94rem;
    font-weight: 610;
    letter-spacing: -0.018em;
  }

  .inbox-header p {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .square-control {
    width: 32px;
    height: 32px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text-dim);
  }

  .case-filters {
    min-height: 45px;
    display: flex;
    align-items: flex-end;
    gap: 17px;
    padding: 0 16px;
    overflow-x: auto;
    border-block: 1px solid var(--border);
    scrollbar-width: none;
  }

  .case-filters::-webkit-scrollbar {
    display: none;
  }

  .case-filters span {
    position: relative;
    min-height: 44px;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    color: var(--text-dim);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .case-filters span.active {
    color: #c5c5cb;
  }

  .case-filters span.active::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: var(--blue);
    content: '';
  }

  .case-filters b,
  .detail-tabs b {
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .case-list {
    list-style: none;
  }

  .case-list li {
    position: relative;
    padding: 14px 16px 13px;
    border-bottom: 1px solid var(--border);
    background: transparent;
  }

  .case-list li.selected {
    background: rgba(86, 137, 232, 0.055);
    box-shadow: inset 2px 0 #5f91ec;
  }

  .case-row-top {
    gap: 9px;
  }

  .case-id {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .case-row-top time {
    margin-left: auto;
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .case-status {
    gap: 6px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .case-status > i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #747781;
  }

  .case-status--blue > i {
    background: var(--blue);
  }

  .case-status--green > i {
    background: var(--green);
  }

  .case-status--amber > i {
    background: var(--amber);
  }

  .case-person {
    min-width: 0;
    gap: 9px;
    margin-top: 11px;
  }

  .case-person :global(img),
  .summary-identity :global(img) {
    flex: 0 0 auto;
    border-radius: 7px;
    object-fit: cover;
  }

  .case-person > span,
  .summary-identity > span {
    min-width: 0;
  }

  .case-person strong,
  .case-person small,
  .summary-identity strong,
  .summary-identity small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .case-person strong {
    font-size: 0.84rem;
    font-weight: 610;
  }

  .case-person small {
    margin-top: 2px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .case-row-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 11px;
    padding-left: 41px;
  }

  .case-row-meta span {
    min-width: 0;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .case-row-meta small {
    display: block;
    margin-bottom: 1px;
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .inbox-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-top: auto;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .inbox-note svg {
    flex: 0 0 auto;
    margin-top: 1px;
  }

  .case-detail {
    min-width: 0;
    background: #0e0f13;
  }

  .detail-header {
    min-height: 84px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }

  .detail-header p {
    gap: 8px;
    margin-bottom: 5px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .detail-header p .mono {
    color: #9ebbf0;
  }

  .detail-header > .case-status {
    min-height: 29px;
    padding: 0 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .member-summary {
    display: grid;
    grid-template-columns: minmax(210px, 0.9fr) minmax(0, 1.1fr);
    gap: 24px;
    padding: 17px 20px;
    border-bottom: 1px solid var(--border);
  }

  .summary-identity {
    min-width: 0;
    gap: 10px;
  }

  .summary-identity strong {
    font-size: 0.9rem;
    font-weight: 620;
  }

  .summary-identity small {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .member-summary dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px 18px;
  }

  .member-summary dt {
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .member-summary dd {
    margin-top: 2px;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail-tabs {
    min-height: 45px;
    display: flex;
    align-items: flex-end;
    gap: 24px;
    padding: 0 20px;
    border-bottom: 1px solid var(--border);
  }

  .detail-tabs span {
    position: relative;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .detail-tabs span.active {
    color: #d5d5d9;
  }

  .detail-tabs span.active::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: var(--blue);
    content: '';
  }

  .timeline-panel {
    padding: 0 20px 20px;
  }

  .timeline-toolbar {
    min-height: 68px;
  }

  .timeline-toolbar h4 {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .timeline-toolbar p {
    margin-top: 2px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .timeline-toolbar > span {
    gap: 7px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .timeline-toolbar > span svg {
    transform: rotate(90deg);
  }

  .timeline-list {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.12);
    list-style: none;
  }

  .timeline-list::before {
    position: absolute;
    top: 28px;
    bottom: 28px;
    left: 20px;
    width: 1px;
    transform: scaleY(0);
    transform-origin: top;
    background: rgba(255, 255, 255, 0.12);
    content: '';
  }

  .timeline-list li {
    position: relative;
    display: grid;
    grid-template-columns: 17px minmax(0, 1fr) 42px;
    gap: 11px;
    min-height: 57px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateY(8px);
  }

  .timeline-list li:last-child {
    border-bottom: 0;
  }

  .timeline-marker {
    z-index: 1;
    width: 9px;
    height: 9px;
    display: grid;
    place-items: center;
    margin-top: 6px;
    margin-left: 4px;
    border: 2px solid #686b73;
    border-radius: 50%;
    background: #111217;
  }

  .timeline-marker--blue {
    border-color: var(--blue);
  }

  .timeline-marker--amber {
    border-color: var(--amber);
  }

  .timeline-marker--green {
    border-color: var(--green);
  }

  .timeline-content {
    min-width: 0;
  }

  .timeline-content > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .timeline-content strong {
    min-width: 0;
    overflow: hidden;
    color: #d9d9de;
    font-size: 0.875rem;
    font-weight: 590;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline-content span {
    flex: 0 0 auto;
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .timeline-content p {
    margin-top: 3px;
    overflow: hidden;
    color: var(--text-dim);
    font-size: 0.75rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline-content .moderator-byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 7px;
    white-space: normal;
    color: var(--text-secondary);
  }
  .moderator-byline b {
    font-weight: 550;
    color: #d9d9de;
  }
  .moderator-byline em {
    font-size: 0.625rem;
    font-style: normal;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 4px;
  }
  .moderator-byline :global(svg) {
    color: #9eb9eb;
    flex-shrink: 0;
  }

  .timeline-list time {
    padding-top: 4px;
    color: var(--text-faint);
    font-size: 0.75rem;
    text-align: right;
  }

  .case-workspace.is-visible .timeline-list::before {
    animation: timeline-line 1.55s var(--ease-out) 100ms both;
  }

  .case-workspace.is-visible .timeline-list li {
    animation: timeline-item 380ms var(--ease-out) var(--timeline-delay) both;
  }

  @keyframes timeline-line {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes timeline-item {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1020px) {
    .case-layout {
      grid-template-columns: 330px minmax(0, 1fr);
    }

    .member-summary {
