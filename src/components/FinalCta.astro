---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section
  class="section final-cta"
  id="get-started"
  aria-labelledby="final-cta-title"
>
  <div class="container final-cta-inner" data-observe-reveal>
    <p class="eyebrow">Less chasing. More community.</p>
    <h2 class="display" id="final-cta-title">
      Give your staff a shared place to work.
    </h2>
    <p>
      Connect your Roblox community and Discord server with Relay. Every core
      module, from $4 per workspace each month.
    </p>
    <div class="final-actions">
      <a class="button button--primary" href={site.links.pricing}>
        View pricing
      </a>
      <a class="button button--secondary" href={site.links.demo}>
        See how it works <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    overflow: hidden;
    padding-block: clamp(116px, 14vw, 190px);
  }

  .final-cta::after {
    position: absolute;
    z-index: -1;
    right: -10%;
    bottom: -260px;
    left: -10%;
    height: 540px;
    background: radial-gradient(
      ellipse at center,
      rgba(56, 105, 195, 0.12),
      transparent 64%
    );
    content: '';
    pointer-events: none;
  }

  .final-cta-inner {
    max-width: 960px;
    text-align: center;
  }

  .final-cta h2 {
    max-width: 13ch;
    margin: 18px auto 0;
    font-size: clamp(2.75rem, 6.2vw, 5.2rem);
  }

  .final-cta p:not(.eyebrow) {
    max-width: 620px;
    margin: 24px auto 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.6;
    text-wrap: balance;
  }

  .final-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 34px;
  }

  @media (max-width: 440px) {
    .final-actions {
      align-items: stretch;
      flex-direction: column;
      max-width: 260px;
      margin-inline: auto;
    }
  }
</style>
