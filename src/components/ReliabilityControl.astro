---
import Icon from './Icon.astro';

const days = [
  { label: 'Mon', value: 142 },
  { label: 'Tue', value: 168 },
  { label: 'Wed', value: 155 },
  { label: 'Thu', value: 204 },
  { label: 'Fri', value: 187 },
  { label: 'Sat', value: 226 },
  { label: 'Sun', value: 166 },
];
const actions = [
  { label: 'Role updates', value: 486 },
  { label: 'Moderation', value: 342 },
  { label: 'Staff shifts', value: 264 },
  { label: 'Other actions', value: 156 },
];
const outcomes = [
  { label: 'Completed', value: 96, color: '#829ff2' },
  { label: 'Needs a retry', value: 3, color: '#d6a65d' },
  { label: 'Failed', value: 1, color: '#d17474' },
];
const platforms = [
  { label: 'Roblox', value: 62, color: '#829ff2' },
  { label: 'Discord', value: 38, color: '#a694d9' },
];
const metrics = [
  { label: 'Total actions', value: '1,248', note: 'Across your workspace' },
  { label: 'Completion rate', value: '96%', note: 'Successfully completed' },
  { label: 'Active staff', value: '42', note: 'Contributing this week' },
  { label: 'Average response', value: '1.2s', note: 'From request to result' },
];
---

<section
  class="section reliability-section"
  id="security"
  aria-labelledby="reliability-title"
>
  <div class="container">
    <div class="section-heading section-heading--center" data-observe-reveal>
      <p class="eyebrow">Analytics and insights</p>
      <h2 class="display section-title" id="reliability-title">
        Your community, by the numbers.
      </h2>
      <p class="section-copy">
        See where your team spends its time, how actions perform and what needs
        attention. A clearer picture of every week.
      </p>
    </div>

    <div class="analytics panel" data-observe-reveal>
      <div class="analytics-header">
        <div>
          <Icon name="ranking" size={17} />
          <h3>Workspace overview</h3>
        </div>
        <div class="analytics-context">
          <span class="sample-label">Sample data</span>
          <span class="date-range">
            <Icon name="calendar" size={14} /> Last 7 days
          </span>
        </div>
      </div>
      <dl class="metrics">
        {metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd class="metric-value mono">{metric.value}</dd>
            <dd class="metric-note">{metric.note}</dd>
          </div>
        ))}
      </dl>
      <div class="charts" data-analytics-charts>
        <figure class="chart activity-chart" aria-labelledby="activity-title">
          <figcaption class="chart-heading">
            <div>
              <h4 id="activity-title">Activity over time</h4>
              <p>Daily workspace actions</p>
            </div>
            <span class="chart-unit">7 days</span>
          </figcaption>
          <div class="chart-canvas daily-canvas">
            <canvas
              data-analytics-chart="activity"
              data-chart-values={JSON.stringify(days)}
              role="img"
              aria-label={`Daily actions: ${days.map((day) => `${day.label} ${day.value}`).join(', ')}.`}
            ></canvas>
          </div>
          <p class="chart-footnote">
            <span class="peak-dot"></span>Peak activity on Saturday
            <strong>226 actions</strong>
          </p>
        </figure>
        <figure class="chart" aria-labelledby="outcomes-title">
          <figcaption class="chart-heading">
            <div>
              <h4 id="outcomes-title">Completion rate</h4>
              <p>Action outcomes this week</p>
            </div>
            <Icon name="check" size={16} />
          </figcaption>
          <div class="round-chart">
            <canvas
              data-analytics-chart="outcomes"
              data-chart-values={JSON.stringify(outcomes)}
              role="img"
              aria-label="96 percent completed, 3 percent need a retry, 1 percent failed."
            ></canvas>
            <div class="donut-label" aria-hidden="true">
              <strong>
                96<span>%</span>
              </strong>
              <span>completed</span>
            </div>
          </div>
          <ul class="chart-legend">
            {outcomes.map((item) => (
              <li>
                <span>
                  <i style={`--key-color: ${item.color}`}></i>
                  {item.label}
                </span>
                <strong>{item.value}%</strong>
              </li>
            ))}
          </ul>
        </figure>
        <figure class="chart" aria-labelledby="types-title">
          <figcaption class="chart-heading">
            <div>
              <h4 id="types-title">Actions by category</h4>
              <p>Where your team spends its time</p>
            </div>
            <span class="chart-unit">1,248 total</span>
          </figcaption>
          <div class="chart-canvas category-canvas">
            <canvas
              data-analytics-chart="categories"
              data-chart-values={JSON.stringify(actions)}
              role="img"
              aria-label={`Actions by category: ${actions.map((action) => `${action.label} ${action.value}`).join(', ')}.`}
            ></canvas>
          </div>
        </figure>
        <figure class="chart" aria-labelledby="platforms-title">
          <figcaption class="chart-heading">
            <div>
              <h4 id="platforms-title">Platform share</h4>
              <p>Connected across your community</p>
            </div>
            <Icon name="link" size={16} />
          </figcaption>
          <div class="platform-layout">
            <div class="round-chart platform-chart">
              <canvas
                data-analytics-chart="platforms"
                data-chart-values={JSON.stringify(platforms)}
                role="img"
                aria-label="Workspace actions: Roblox 62 percent, Discord 38 percent."
              ></canvas>
            </div>
            <ul class="chart-legend">
              {platforms.map((item) => (
                <li>
                  <span>
                    <i style={`--key-color: ${item.color}`}></i>
                    {item.label}
                  </span>
                  <strong>{item.value}%</strong>
                </li>
              ))}
            </ul>
          </div>
        </figure>
      </div>
      <details class="chart-data">
        <summary>View chart data</summary>
        <div class="data-tables">
          {[
            { title: 'Daily actions', rows: days, unit: 'actions' },
            { title: 'Action categories', rows: actions, unit: 'actions' },
            { title: 'Action outcomes', rows: outcomes, unit: '%' },
            { title: 'Platform share', rows: platforms, unit: '%' },
          ].map((group) => (
            <table>
              <caption>{group.title}</caption>
              <thead>
                <tr>
                  <th scope="col">Category</th>
                  <th scope="col">
                    {group.unit === '%' ? 'Share' : 'Actions'}
                  </th>
                </tr>
              </thead>
              <tbody>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>
                      {row.value}
                      {group.unit === '%' ? '%' : ''}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          ))}
        </div>
      </details>
      <div class="analytics-footer">
        <Icon name="shield" size={14} />
        <span>One workspace. Every action accounted for.</span>
        <span class="footer-note">Illustrative preview</span>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/analytics-charts';
</script>

<style>
  .reliability-section {
    overflow: clip;
  }
  .analytics {
    background: #0e0f13;
    overflow: hidden;
    border-color: #ffffff12;
  }
  .analytics-header,
  .analytics-header > div,
  .date-range,
  .analytics-footer {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .analytics-header {
    justify-content: space-between;
    padding: 22px 28px;
    border-bottom: 1px solid var(--border);
  }
  .analytics-header h3 {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .analytics-header :global(svg) {
    color: var(--text-dim);
  }
  .analytics-context {
    font-size: 0.75rem;
    color: var(--text-dim);
    gap: 18px !important;
  }
  .date-range {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 9px;
    color: var(--text-secondary);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 30px 0;
  }
  .metrics > div {
    padding: 0 28px;
    border-right: 1px solid var(--border);
  }
  .metrics > div:last-child {
    border: 0;
  }
  .metrics dt {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .metric-value {
    margin-top: 10px;
    font-family: var(--sans);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .metric-note {
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .charts {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 16px;
    padding: 0 20px 20px;
  }
  .chart {
    min-width: 0;
    margin: 0;
    padding: 24px;
    border: 1px solid #ffffff0c;
    border-radius: 10px;
    background: #13151b;
  }
  .chart-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 14px;
  }
  .chart-heading h4 {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .chart-heading p {
    margin-top: 5px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .chart-heading :global(svg) {
    color: var(--text-dim);
  }
  .chart-unit {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .chart-canvas {
    position: relative;
    width: 100%;
    margin-top: 24px;
  }
  .daily-canvas {
    height: 255px;
  }
  .category-canvas {
    height: 236px;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .chart-footnote {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .chart-footnote strong {
    color: var(--text-secondary);
    font-weight: 500;
    margin-left: auto;
  }
  .peak-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #829ff2;
  }
  .round-chart {
    position: relative;
    width: 184px;
    height: 184px;
    margin: 24px auto;
  }
  .donut-label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .donut-label strong {
    font-size: 2.2rem;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1.25;
  }
  .donut-label strong > span {
    font-size: 1.2rem;
    margin-left: 2px;
    color: var(--text-secondary);
  }
  .donut-label > span {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-top: 3px;
  }
  .chart-legend {
    list-style: none;
    display: grid;
    gap: 0;
    max-width: 300px;
    margin-inline: auto;
    width: 100%;
  }
  .chart-legend li,
  .chart-legend li > span {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .chart-legend li {
    justify-content: space-between;
    padding: 8px 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .chart-legend li + li {
    border-top: 1px solid #ffffff06;
  }
  .chart-legend i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--key-color);
    flex-shrink: 0;
  }
  .chart-legend strong {
    color: var(--text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .platform-chart {
    width: 160px;
    height: 160px;
    margin-block: 20px 14px;
  }
  .chart-data {
    padding: 0 28px 18px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .chart-data summary {
    cursor: pointer;
    width: fit-content;
  }
  .chart-data summary:focus-visible {
    outline: 2px solid #829ff2;
    outline-offset: 4px;
  }
  .data-tables {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 20px;
  }
  .data-tables table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .data-tables caption {
    text-align: left;
    color: var(--text);
    margin-bottom: 10px;
  }
  .data-tables th,
  .data-tables td {
    font-weight: 400;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
  }
  .data-tables td,
  .data-tables thead th:last-child {
    text-align: right;
  }
  .analytics-footer {
    padding: 16px 28px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .analytics-footer :global(svg) {
    flex-shrink: 0;
    color: #829ff2;
  }
  .footer-note {
    margin-left: auto;
  }
  @media (max-width: 1000px) {
    .charts {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
    .chart {
      padding: 20px;
    }
    .metrics > div {
      padding-inline: 22px;
    }
  }
  @media (max-width: 760px) {
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 0;
    }
    .metrics > div:nth-child(2) {
      border: 0;
    }
    .charts {
      grid-template-columns: 1fr;
    }
    .chart-unit {
      display: none;
    }
    .data-tables {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .round-chart {
      width: 190px;
      height: 190px;
    }
    .platform-layout {
      display: flex;
      align-items: center;
      gap: 28px;
    }
    .platform-chart {
      width: 160px;
      height: 160px;
      flex-shrink: 0;
    }
  }
  @media (max-width: 480px) {
    .analytics-header {
      align-items: start;
      gap: 14px;
      flex-direction: column;
      padding: 18px;
    }
    .analytics-context {
      width: 100%;
      justify-content: space-between;
    }
    .metrics > div {
      padding-inline: 18px;
    }
    .charts {
      padding-inline: 10px;
      gap: 10px;
    }
    .chart {
      padding: 20px 14px;
    }
    .daily-canvas {
      height: 230px;
    }
    .platform-layout {
      display: block;
    }
    .analytics-footer {
      padding-inline: 18px;
    }
    .footer-note {
      display: none;
    }
    .chart-data {
      padding-inline: 18px;
    }
    .data-tables {
      grid-template-columns: 1fr;
    }
  }
</style>
