---
import { faqs } from '../data/site';
---

<section class="section faq-section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div class="section-heading" data-observe-reveal>
      <p class="eyebrow">Questions, answered</p>
      <h2 class="display section-title" id="faq-title">
        Know exactly what connects.
      </h2>
      <p class="section-copy">
        Straight answers about access, billing, integrations and what the
        product deliberately does not automate.
      </p>
    </div>

    <div class="faq-list" data-observe-reveal>
      {faqs.map((faq, index) => (
        <details open={index === 0}>
          <summary>
            <span>{faq.question}</span>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <div>
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(48px, 8vw, 110px);
    align-items: start;
  }

  .faq-layout .section-heading {
    position: sticky;
    top: calc(var(--header-height) + 40px);
    margin-bottom: 0;
  }

  .faq-list {
    border-top: 1px solid var(--border-strong);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 4px;
    cursor: pointer;
    color: #e8e8eb;
    font-size: 0.98rem;
    font-weight: 580;
    letter-spacing: -0.015em;
    list-style: none;
    transition: color 180ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: white;
  }

  .faq-plus {
    position: relative;
    width: 24px;
    height: 24px;
    flex: 0 0 auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .faq-plus::before,
  .faq-plus::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 1px;
    background: var(--text-secondary);
    content: '';
    transform: translate(-50%, -50%);
    transition: transform 220ms ease;
  }

  .faq-plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .faq-plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  summary[aria-expanded='false'] .faq-plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details > div > p {
    max-width: 68ch;
    overflow: hidden;
    padding: 0 48px 0 4px;
    color: var(--text-secondary);
    font-size: 0.87rem;
    line-height: 1.65;
  }

  details[open] > div > p {
    padding-bottom: 24px;
  }

  @media (max-width: 820px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .faq-layout .section-heading {
      position: static;
      margin-bottom: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-plus::before,
    .faq-plus::after,
    details > div {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/faq-motion';
</script>
