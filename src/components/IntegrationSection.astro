---
import Icon from './Icon.astro';
import { integrations } from '../data/site';

const scopes = [
  'Scoped API',
  'Bot + OAuth',
  'Versioned hooks',
  'Version matrix',
  'Allowlisted',
  'Hosted billing',
];
---

<section
  class="section integration-section"
  id="integrations"
  aria-labelledby="integration-title"
>
  <div class="container">
    <div class="section-heading" data-observe-reveal>
      <p class="eyebrow">Integrations</p>
      <h2 class="display section-title" id="integration-title">
        Built around the tools your community already uses.
      </h2>
      <p class="section-copy">
        Keep using Discord, Roblox and your supported admin framework. Choose
        the connections your community needs and see what each supports.
      </p>
    </div>

    <div class="integration-layout">
      <div class="integration-list" data-reveal-group>
        {integrations.map((integration, index) => (
          <article>
            <span class="integration-icon">
              <Icon name={integration.icon} size={20} />
            </span>
            <div>
              <h3>{integration.name}</h3>
              <p>{integration.description}</p>
            </div>
            <span class="integration-scope mono">{scopes[index]}</span>
          </article>
        ))}
      </div>

      <aside
        class="coverage-panel panel"
        aria-labelledby="coverage-title"
        data-observe-reveal
      >
        <div class="coverage-header">
          <div>
            <span class="mono">YOUR CONNECTIONS</span>
            <h3 id="coverage-title">See what’s supported</h3>
          </div>
          <span class="demo-label">Example</span>
        </div>

        <div class="coverage-version">
          <span>
            <Icon name="adonis" size={26} />
            Adonis connection
          </span>
          <strong class="mono">Adonis · supported release</strong>
        </div>

        <dl class="coverage-list">
          <div>
            <dt>Action logging</dt>
            <dd class="is-supported">
              <Icon name="check" size={13} />
              Supported
            </dd>
          </div>
          <div>
            <dt>Experience restriction</dt>
            <dd class="is-supported">
              <Icon name="check" size={13} />
              Supported
            </dd>
          </div>
          <div>
            <dt>Attendance events</dt>
            <dd class="is-supported">
              <Icon name="check" size={13} />
              Supported
            </dd>
          </div>
          <div>
            <dt>Arbitrary remote Lua</dt>
            <dd class="not-supported">Not exposed</dd>
          </div>
          <div>
            <dt>Unconfigured operations</dt>
            <dd class="not-supported">Shown as unsupported</dd>
          </div>
        </dl>

        <p class="coverage-note">
          Supported features vary by framework and version. Check the coverage
          for your setup before connecting an experience.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .integration-section {
    background: linear-gradient(
      180deg,
      transparent,
      rgba(255, 255, 255, 0.012),
      transparent
    );
  }

  .integration-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, 0.88fr);
    gap: clamp(30px, 5vw, 72px);
    align-items: start;
  }

  .integration-list {
    border-top: 1px solid var(--border-strong);
  }

  .integration-list article {
    min-height: 104px;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 18px 6px;
    border-bottom: 1px solid var(--border);
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .integration-list article:hover {
    border-bottom-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.012);
  }

  .integration-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.025);
    color: #8daff0;
  }

  .integration-list h3 {
    font-size: 0.96rem;
    font-weight: 620;
    letter-spacing: -0.016em;
  }

  .integration-list p {
    max-width: 58ch;
    margin-top: 5px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .integration-scope {
    color: var(--text-dim);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .coverage-panel {
    position: sticky;
    top: calc(var(--header-height) + 28px);
    overflow: hidden;
  }

  .coverage-header {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
  }

  .coverage-header .mono {
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .coverage-header h3 {
    margin-top: 4px;
    font-size: 0.92rem;
    font-weight: 610;
  }

  .coverage-version {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(86, 137, 232, 0.045);
  }

  .coverage-version span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .coverage-version strong {
    color: #9eb9eb;
    font-size: 0.75rem;
    font-weight: 500;
    text-align: right;
  }

  .coverage-list > div {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
  }

  .coverage-list dt,
  .coverage-list dd {
    font-size: 0.75rem;
  }

  .coverage-list dt {
    color: var(--text-secondary);
  }

  .coverage-list dd {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-align: right;
  }

  .coverage-list .is-supported {
    color: #82c99e;
  }

  .coverage-list .not-supported {
    color: var(--text-dim);
  }

  .coverage-note {
    margin: 18px;
    padding: 14px;
    border: 1px solid rgba(214, 166, 93, 0.16);
    border-radius: 8px;
    background: rgba(214, 166, 93, 0.05);
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .integration-layout {
      grid-template-columns: 1fr;
    }

    .coverage-panel {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .integration-list article {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 14px;
    }

    .integration-scope {
      grid-column: 2;
      margin-top: -9px;
    }

    .coverage-version {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
      padding-block: 13px;
    }

    .coverage-version strong {
      text-align: left;
    }

    .coverage-list > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .coverage-list dd {
      text-align: left;
    }
  }
</style>
