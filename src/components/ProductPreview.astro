---
import { Image } from 'astro:assets';
import annieAvatar from '../assets/annie-fernanda.webp';
import chrxsAvatar from '../assets/chrxs-dev-avatar.webp';
import haleyAvatar from '../assets/haley-morgan.webp';
import planeAvatar from '../assets/plane20master.webp';
import ronaldAvatar from '../assets/ronald-ramirez.webp';
import { site } from '../data/site';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';

const members = [
  {
    name: 'chrxs_dev',
    id: '851394804',
    role: 'Host',
    next: 'Senior Host',
    avatar: chrxsAvatar,
  },
  {
    name: 'Haley_morgan1',
    id: '187492605',
    role: 'Receptionist',
    next: 'Host',
    avatar: haleyAvatar,
  },
  {
    name: 'RonaldRamirez73',
    id: '284610395',
    role: 'Trainee',
    next: 'Receptionist',
    avatar: ronaldAvatar,
  },
  {
    name: 'AnnieFernanda',
    id: '391720486',
    role: 'Host',
    next: 'Senior Host',
    avatar: annieAvatar,
  },
  {
    name: 'PLANE20MASTER',
    id: '1046283917',
    role: 'Senior Host',
    next: 'Head Host',
    avatar: planeAvatar,
  },
];
const steps = ['Find a member', 'Review promotion', 'See the result'];
---

<section
  class="product-preview"
  id="demo"
  data-product-preview
  data-step="0"
  aria-label="Interactive Relay product preview"
>
  <div class="preview-intro">
    <span class="eyebrow">A small look inside Relay</span>
    <span class="preview-hint">
      <i></i>Try a promotion with sample data
    </span>
  </div>
  <div class="preview-window">
    <header class="window-bar">
      <span class="window-brand">
        <BrandMark />
        <strong>{site.name}</strong>
        <span class="window-separator">/</span>
        <span>Koyot Digital</span>
      </span>
      <span class="sample-badge">Sample workspace</span>
    </header>
    <div class="preview-walkthrough">
      <div
        class="walkthrough-tabs"
        role="tablist"
        aria-label="Promotion preview steps"
      >
        {steps.map((step, index) => (
          <button
            type="button"
            role="tab"
            id={`preview-step-${index}`}
            data-preview-step
            aria-selected={index === 0}
            aria-controls={`preview-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <span class="step-number">0{index + 1}</span>
            <span>{step}</span>
            <Icon name="chevron" size={13} />
          </button>
        ))}
      </div>
      <span class="walkthrough-note">Explore at your own pace</span>
    </div>
    <div class="app-shell">
      <aside class="preview-sidebar" aria-label="Workspace context">
        <div class="workspace-name">
          <span class="workspace-avatar">KD</span>
          <div>
            <strong>Koyot Digital</strong>
            <small>Community workspace</small>
          </div>
        </div>
        <p class="sidebar-label">Workspace</p>
        <ul class="sidebar-items" aria-label="Sample navigation">
          <li>
            <Icon name="overview" size={16} />
            Overview
          </li>
          <li class="active">
            <Icon name="users" size={16} />
            Members<span>5</span>
          </li>
          <li>
            <Icon name="calendar" size={16} />
            Events
          </li>
          <li>
            <Icon name="case" size={16} />
            Cases<span>3</span>
          </li>
          <li>
            <Icon name="megaphone" size={16} />
            Announcements
          </li>
        </ul>
        <div class="sidebar-connections">
          <p class="sidebar-label">Connections</p>
          <span>
            <Icon name="roblox" size={15} />
            Roblox<i></i>
          </span>
          <span>
            <Icon name="discord" size={15} />
            Discord<i></i>
          </span>
        </div>
        <div class="sidebar-user">
          <span>MN</span>
          <div>
            <strong>MiraNorth</strong>
            <small>Community owner</small>
          </div>
        </div>
      </aside>
      <div class="workspace-main">
        <div class="workspace-toolbar">
          <span>
            <Icon name="users" size={16} />
            Members
          </span>
          <span class="toolbar-context">
            <Icon name="link" size={14} />
            Roblox + Discord
          </span>
        </div>
        <div class="workspace-content">
          <div class="directory">
            <div class="directory-heading">
              <h2>People, connected.</h2>
              <p>One member. The full picture.</p>
            </div>
            <label class="member-search">
              <Icon name="search" size={16} />
              <span class="sr-only">
                Search sample members by username or Roblox ID
              </span>
              <input
                data-preview-search
                type="search"
                placeholder="Find a member…"
                autocomplete="off"
                spellcheck="false"
              />
            </label>
            <div class="list-heading">
              <span>Verified members</span>
              <span data-preview-count aria-live="polite">
                5 members
              </span>
            </div>
            <div class="member-list" aria-label="Sample community members">
              {members.map((member, index) => (
                <button
                  class="member-row"
                  type="button"
                  data-preview-member
                  data-name={member.name}
                  data-roblox-id={member.id}
                  data-role={member.role}
                  data-next={member.next}
                  aria-pressed={index === 0}
                >
                  <Image
                    src={member.avatar}
                    alt=""
                    width={52}
                    height={52}
                    loading="lazy"
                  />
                  <span class="member-label">
                    <strong>{member.name}</strong>
                    <small data-member-role>{member.role}</small>
                  </span>
                  <Icon name="chevron" size={15} />
                </button>
              ))}
              <div class="empty-state" data-preview-empty hidden>
                <Icon name="search" size={22} />
                <p>No matching members</p>
                <button type="button" data-preview-clear>
                  Clear search
                </button>
              </div>
            </div>
            <div class="directory-note">
              <Icon name="lock" size={14} />
              <span>Staff permissions apply to every change.</span>
            </div>
          </div>
          <div class="member-inspector">
            <div class="inspector-top">
              <span class="inspector-label">Member record</span>
              <span class="verified">
                <Icon name="check" size={12} />
                Verified
              </span>
            </div>
            <div class="profile-header">
              <Image
                src={chrxsAvatar}
                alt=""
                width={52}
                height={52}
                data-selected-avatar
              />
              <div>
                <h3 data-selected-name>chrxs_dev</h3>
                <p>
                  Roblox ID{' '}
                  <span class="mono" data-selected-id>
                    851394804
                  </span>
                </p>
              </div>
            </div>
            <div class="inspector-panels">
              <section
                id="preview-panel-0"
                role="tabpanel"
                aria-labelledby="preview-step-0"
                data-preview-panel
                tabindex="0"
              >
                <div class="account-rows">
                  <div>
                    <span>
                      <Icon name="roblox" size={18} />
                      Roblox rank
                    </span>
                    <strong data-selected-role>Host</strong>
                  </div>
                  <div>
                    <span>
                      <Icon name="discord" size={18} />
                      Discord role
                    </span>
                    <strong data-selected-role>Host</strong>
                  </div>
                </div>
                <div class="record-heading">
                  <span>Latest activity</span>
                  <span>Today</span>
                </div>
                <div class="activity-item">
                  <span class="activity-icon">
                    <Icon name="events" size={17} />
                  </span>
                  <div>
                    <strong>Training result confirmed</strong>
                    <p>Passed · recorded by MiraNorth</p>
                    <span>Ready for a promotion review</span>
                  </div>
                </div>
                <button
                  class="preview-action"
                  type="button"
                  data-preview-review
                >
                  Review promotion <Icon name="arrow" size={16} />
                </button>
                <p class="action-note">
                  Choose a member, then follow their promotion.
                </p>
              </section>
              <section
                id="preview-panel-1"
                role="tabpanel"
                aria-labelledby="preview-step-1"
                data-preview-panel
                tabindex="0"
                hidden
              >
                <div class="review-title">
                  <span>Proposed role change</span>
                  <span class="review-badge">Needs approval</span>
                </div>
                <div class="rank-change">
                  <span data-selected-role>Host</span>
                  <Icon name="arrow" size={19} />
                  <strong data-selected-next>Senior Host</strong>
                </div>
                <ul class="approval-checks">
                  <li>
                    <Icon name="check" size={15} />
                    Training result confirmed
                  </li>
                  <li>
                    <Icon name="check" size={15} />
                    Role available to this reviewer
                  </li>
                  <li>
                    <Icon name="check" size={15} />
                    Discord role mapping configured
                  </li>
                </ul>
                <button
                  class="preview-action"
                  type="button"
                  data-preview-approve
                >
                  Approve sample promotion <Icon name="arrow" size={16} />
                </button>
                <p class="action-note">
                  Sample data only. No real accounts are changed.
                </p>
              </section>
              <section
                id="preview-panel-2"
                role="tabpanel"
                aria-labelledby="preview-step-2"
                data-preview-panel
                tabindex="0"
                hidden
              >
                <div class="result-heading">
                  <span class="result-check">
                    <Icon name="check" size={20} />
                  </span>
                  <div>
                    <h4>Promotion complete</h4>
                    <p>
                      <span data-selected-next>Senior Host</span> · both
                      platforms confirmed
                    </p>
                  </div>
                </div>
                <ol class="result-receipt">
                  <li>
                    <span>
                      <Icon name="shield" size={16} />
                      Approved by MiraNorth
                    </span>
                    <small>Recorded</small>
                  </li>
                  <li>
                    <span>
                      <Icon name="roblox" size={16} />
                      Roblox rank updated
                    </span>
                    <Icon name="check" size={15} />
                  </li>
                  <li>
                    <span>
                      <Icon name="discord" size={16} />
                      Discord role synced
                    </span>
                    <Icon name="check" size={15} />
                  </li>
                  <li>
                    <span>
                      <Icon name="note" size={16} />
                      Saved to member history
                    </span>
                    <Icon name="check" size={15} />
                  </li>
                </ol>
                <button
                  class="preview-action preview-action--secondary"
                  type="button"
                  data-preview-reset
                >
                  <Icon name="refresh" size={15} />
                  Try another promotion
                </button>
                <p class="action-note">
                  A sample of the record your staff can return to.
                </p>
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p
    class="sr-only"
    aria-live="polite"
    aria-atomic="true"
    data-preview-announcement
  ></p>
  <noscript>
    <p class="action-note">Enable JavaScript to try this sample promotion.</p>
  </noscript>
</section>

<script>
  import '../scripts/product-preview';
</script>

<style>
  .product-preview {
    width: 100%;
    position: relative;
    z-index: 2;
    text-align: left;
  }
  .preview-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    padding-inline: 3px;
  }
  .preview-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .preview-hint i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
  }
  .preview-window {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: #0d0e11;
    box-shadow:
      0 32px 100px -30px #0009,
      0 0 70px -35px #5689e821;
  }
  .window-bar {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, #ffffff04, transparent);
  }
  .window-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .window-brand strong {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }
  .window-separator {
    color: #ffffff26;
  }
  .sample-badge {
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 5px;
    color: var(--text-dim);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .app-shell {
    display: grid;
    grid-template-columns: 178px minmax(0, 1fr);
  }
  .preview-sidebar {
    display: flex;
    flex-direction: column;
    padding: 20px 12px 14px;
    border-right: 1px solid var(--border);
    background: #0a0b0d;
  }
  .workspace-name {
    display: flex;
    gap: 9px;
    align-items: center;
    padding-inline: 2px;
    margin-bottom: 28px;
  }
  .workspace-avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: #20232b;
    color: #ccd5e7;
    font-size: 0.75rem;
    flex-shrink: 0;
  }
  .workspace-name strong,
  .sidebar-user strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 550;
  }
  .workspace-name small,
  .sidebar-user small {
    display: block;
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .sidebar-label {
    color: var(--text-faint);
    font-size: 0.75rem;
    padding-inline: 8px;
    margin-bottom: 8px;
  }
  .sidebar-items {
    display: grid;
    gap: 3px;
    list-style: none;
  }
  .sidebar-items li {
    min-height: 35px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .sidebar-items li :global(svg) {
    flex-shrink: 0;
  }
  .sidebar-items li span {
    margin-left: auto;
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .sidebar-items .active {
    background: #ffffff08;
    border-color: #ffffff07;
    color: var(--text);
  }
  .sidebar-connections {
    margin-top: 24px;
  }
  .sidebar-connections > span {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 8px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .sidebar-connections i {
    width: 5px;
    height: 5px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--green);
  }
  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: auto;
    padding: 24px 4px 0;
  }
  .sidebar-user > span {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-size: 0.75rem;
    background: #1b1824;
    color: #b9aecf;
  }
  .workspace-main {
    min-width: 0;
  }
  .workspace-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 15px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .workspace-toolbar > span {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .toolbar-context {
    color: var(--text-faint);
  }
  .workspace-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
    padding: 28px;
    align-items: start;
  }
  .directory {
    min-width: 0;
  }
  .directory-heading h2 {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }
  .directory-heading p {
    margin-top: 8px;
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  .member-search {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    margin-top: 22px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    color: var(--text-dim);
    background: #ffffff03;
    transition: border-color 180ms;
  }
  .member-search:focus-within {
    border-color: var(--blue);
  }
  .member-search :global(svg) {
    flex-shrink: 0;
  }
  .member-search input {
    min-width: 0;
    width: 100%;
    padding: 10px 0;
    border: 0;
    outline: none;
    background: transparent;
    font-size: 0.875rem;
  }
  .member-search input::placeholder {
    color: var(--text-faint);
  }
  .list-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 2px 10px;
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .member-list {
    display: grid;
    gap: 4px;
    min-height: 296px;
    align-content: start;
  }
  .member-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 56px;
    padding: 9px 10px;
    text-align: left;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms,
      background-color 160ms;
  }
  .member-row:hover {
    background: #ffffff04;
  }
  .member-row[aria-pressed='true'] {
    background: #5689e80d;
    border-color: #5689e82b;
  }
  .member-row[hidden],
  .empty-state[hidden],
  [data-preview-panel][hidden] {
    display: none;
  }
  .member-row img {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 8px;
    background: #1d2027;
  }
  .member-label {
    display: grid;
    min-width: 0;
    gap: 3px;
  }
  .member-label strong {
    font-size: 0.875rem;
    font-weight: 550;
    overflow-wrap: anywhere;
  }
  .member-label small {
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .member-row > :global(svg) {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--text-faint);
  }
  .member-row[aria-pressed='true'] > :global(svg) {
    color: #9dbcf2;
  }
  .directory-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 17px;
    padding-inline: 2px;
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .directory-note :global(svg) {
    flex-shrink: 0;
  }
  .empty-state {
    text-align: center;
    padding: 36px 8px;
    color: var(--text-dim);
  }
  .empty-state :global(svg) {
    margin-inline: auto;
  }
  .empty-state p {
    margin: 12px 0 4px;
    font-size: 0.875rem;
  }
  .empty-state button {
    min-height: 44px;
    color: var(--text);
    background: transparent;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    font-size: 0.875rem;
  }
  .member-inspector {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: linear-gradient(160deg, #ffffff03, transparent 45%), #111318;
    box-shadow: 0 15px 32px -22px #000a;
  }
  .inspector-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }
  .inspector-label {
    color: var(--text-dim);
    font-size: 0.75rem;
  }
  .verified {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #8fc7a4;
    font-size: 0.75rem;
  }
  .profile-header {
    display: flex;
    gap: 13px;
    align-items: center;
    padding: 22px 20px;
  }
  .profile-header img {
    flex-shrink: 0;
    border-radius: 11px;
    background: #1d2027;
  }
  .profile-header > div {
    min-width: 0;
  }
  .profile-header h3 {
    font-size: 1.0625rem;
    font-weight: 550;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .profile-header p {
    margin-top: 5px;
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .profile-header .mono {
    font-size: 0.75rem;
  }
  .inspector-panels {
    padding: 0 20px 18px;
  }
  [data-preview-panel] {
    min-height: 310px;
  }
  [data-ready='true'] [data-preview-panel]:not([hidden]) {
    animation: panel-enter 220ms var(--ease-out);
  }
  .account-rows {
    display: grid;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #090a0d40;
  }
  .account-rows > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 13px 12px;
  }
  .account-rows > div + div {
    border-top: 1px solid var(--border);
  }
  .account-rows span {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }
  .account-rows strong {
    font-size: 0.875rem;
    font-weight: 500;
    text-align: right;
  }
  .record-heading {
    display: flex;
    justify-content: space-between;
    margin-top: 23px;
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .activity-item {
    display: flex;
    gap: 10px;
    margin-top: 13px;
    margin-bottom: 23px;
  }
  .activity-icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid #68b98a20;
    border-radius: 8px;
    background: #68b98a0a;
    color: #8fc7a4;
  }
