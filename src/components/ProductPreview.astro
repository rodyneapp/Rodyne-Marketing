---
import { Image } from 'astro:assets';
import annieAvatar from '../assets/annie-fernanda.webp';
import chrxsAvatar from '../assets/chrxs-dev-avatar.webp';
import haleyAvatar from '../assets/haley-morgan.webp';
import planeAvatar from '../assets/plane20master.webp';
import ronaldAvatar from '../assets/ronald-ramirez.webp';
import { site } from '../data/site';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';

const members = [
  {
    username: 'chrxs_dev',
    robloxId: '851394804',
    discordId: '1192847461035827290',
    role: 'Host',
    updated: '2m ago',
    featured: true,
    avatar: chrxsAvatar,
  },
  {
    username: 'Haley_morgan1',
    robloxId: '187492605',
    discordId: '1047283956102847619',
    role: 'Receptionist',
    updated: '18m ago',
    featured: false,
    avatar: haleyAvatar,
  },
  {
    username: 'RonaldRamirez73',
    robloxId: '284610395',
    discordId: '927461038572041326',
    role: 'Trainee',
    updated: '1h ago',
    featured: false,
    avatar: ronaldAvatar,
  },
  {
    username: 'AnnieFernanda',
    robloxId: '391720486',
    discordId: '1180527394618273046',
    role: 'Host',
    updated: '3h ago',
    featured: false,
    avatar: annieAvatar,
  },
  {
    username: 'PLANE20MASTER',
    robloxId: '1046283917',
    discordId: '1083147629508374162',
    role: 'Senior Host',
    updated: 'Yesterday',
    featured: false,
    avatar: planeAvatar,
  },
] as const;
---

<figure
  class="product-preview"
  id="demo"
  data-hero-reveal
  data-animated-preview
  data-demo-screen="overview"
  data-demo-toast="hidden"
  data-demo-phase="0"
  aria-describedby="demo-description"
>
  <figcaption class="sr-only" id="demo-description">
    Animated sample workspace: open Members, search chrxs_dev, choose Senior
    Host from the role dropdown, then approve the promotion in the confirmation
    toast.
  </figcaption>

  <div class="preview-window" aria-hidden="true">
    <div class="window-bar">
      <span class="window-dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="window-brand">
        <BrandMark />
        <strong>{site.name}</strong>
      </span>
      <span class="demo-state">
        <i></i>Product preview <span>· Sample data</span>
      </span>
      <span class="demo-progress"></span>
    </div>

    <div class="app-shell">
      <aside class="preview-sidebar">
        <div class="community-switcher">
          <span class="community-mark">KD</span>
          <span>
            <strong>Koyot Digital</strong>
            <small>Community workspace</small>
          </span>
          <Icon name="chevron" size={13} />
        </div>

        <nav aria-label="Demo workspace">
          <span class="nav-overview">
            <Icon name="overview" size={15} />
            Overview
          </span>
          <span>
            <Icon name="inbox" size={15} />
            Action inbox<small>3</small>
          </span>
          <span class="nav-members" data-demo-members-target>
            <Icon name="users" size={15} />
            Members
          </span>
          <span>
            <Icon name="calendar" size={15} />
            Events
          </span>
          <span>
            <Icon name="case" size={15} />
            Cases<small>1</small>
          </span>
          <span>
            <Icon name="megaphone" size={15} />
            Announcements
          </span>
        </nav>

        <div class="sidebar-trend">
          <div>
            <span>Activity</span>
            <small>Last 7 days</small>
          </div>
          <svg viewBox="0 0 152 42" role="presentation">
            <path d="M1 33.5 18 29l17 3 17-16 17 5 17-10 17 7 17-13 16 7 15-7" />
          </svg>
          <span class="trend-caption">Staff actions and confirmed results</span>
        </div>
      </aside>

      <section class="preview-main">
        <header class="main-toolbar">
          <p>
            <span>Koyot Digital</span>
            <i>/</i>
            <strong data-demo-page-title>Overview</strong>
          </p>
          <span class="command-search">
            <Icon name="search" size={13} />
            Search <kbd>⌘ K</kbd>
          </span>
        </header>

        <div class="mobile-preview-nav">
          <span class="nav-overview">Overview</span>
          <span class="nav-members" data-demo-members-target>
            <Icon name="users" size={14} />
            Members
          </span>
        </div>
        <div class="overview-page">
          <p class="preview-eyebrow">Your workspace</p>
          <h3>Good evening, Mira.</h3>
          <p>Here’s what’s happening in Koyot Digital.</p>
          <div class="overview-stats">
            <div>
              <span>Verified members</span>
              <strong>5</strong>
              <small>Roblox + Discord connected</small>
            </div>
            <div>
              <span>Upcoming sessions</span>
              <strong>3</strong>
              <small>Your team is ready</small>
            </div>
            <div>
              <span>Open cases</span>
              <strong>1</strong>
              <small>Assigned to your staff</small>
            </div>
          </div>
          <div class="overview-activity">
            <p class="mono">LATEST ACTIVITY</p>
            <div>
              <Icon name="events" size={18} />
              <span>
                <strong>Front Desk Training completed</strong>
                <small>Results recorded by MiraNorth</small>
              </span>
              <span class="status status--green">Recorded</span>
            </div>
            <div>
              <Icon name="users" size={18} />
              <span>
                <strong>chrxs_dev is ready for review</strong>
                <small>Training result added to member history</small>
              </span>
              <span class="status status--blue">Member update</span>
            </div>
          </div>
        </div>
        <div class="member-page">
          <div class="page-heading">
            <div>
              <p class="preview-eyebrow">Community</p>
              <h3>Members</h3>
              <p>Search verified users and choose their Roblox role.</p>
            </div>
            <span class="member-count">
              <Icon name="users" size={14} />5 members
            </span>
          </div>

          <div class="member-directory">
            <div class="directory-toolbar">
              <div class="member-search" data-demo-search-target>
                <Icon name="search" size={15} />
                <span data-demo-search-value>
                  Search by username or Roblox ID…
                </span>
                <i class="typing-caret"></i>
              </div>
              <span class="filter-label">
                <Icon name="filter" size={14} />
                All roles
              </span>
            </div>

            <div class="member-table">
              <div class="table-head">
                <span>Member</span>
                <span>Roblox role</span>
                <span>Last updated</span>
              </div>

              {members.map((member) => (
                <div
                  class:list={[
                    'member-row',
                    { 'member-row--featured': member.featured },
                  ]}
                >
                  <div class="member-identity">
                    <Image
                      class="member-avatar"
                      src={member.avatar}
                      alt=""
                      width={38}
                      height={38}
                      loading={member.featured ? 'eager' : 'lazy'}
                    />
                    <span class="identity-line">
                      <strong>{member.username}</strong>
                      <small class="mono">
                        · {member.robloxId} :: {member.discordId}
                      </small>
                    </span>
                  </div>

                  <div class="role-cell">
                    <span
                      class="role-select"
                      data-demo-role-target={member.featured ? '' : undefined}
                    >
                      <span
                        data-demo-role-value={member.featured ? '' : undefined}
                      >
                        {member.role}
                      </span>
                      <svg viewBox="0 0 16 16">
                        <path d="m4.5 6.25 3.5 3.5 3.5-3.5" />
                      </svg>
                    </span>

                    {member.featured && (
                      <div class="role-menu">
                        <span>Trainee</span>
                        <span>Receptionist</span>
                        <span class="current">
                          Host <small>Current</small>
                        </span>
                        <span class="target" data-demo-role-option>
                          Senior Host
                        </span>
                      </div>
                    )}
                  </div>

                  <time>{member.updated}</time>
                </div>
              ))}
            </div>

            <div class="directory-footer">
              <span>
                <Icon name="lock" size={13} />
                Only roles available to this staff member are shown.
              </span>
              <span class="mono" data-demo-result-count>
                5 results
              </span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="approval-toast">
      <span class="toast-icon">
        <Icon name="ranking" size={20} />
      </span>
      <div class="toast-copy">
        <strong data-toast-title>Approve role change?</strong>
        <p data-toast-description>chrxs_dev · Host → Senior Host</p>
        <small data-toast-note>
          Updates Roblox rank and the mapped Discord role.
        </small>
      </div>
      <span class="toast-approve" data-demo-approve-target>
        Approve <Icon name="check" size={14} />
      </span>
      <span class="toast-success">
        <Icon name="check" size={20} />
      </span>
    </div>
    <span class="demo-cursor" data-demo-cursor>
      <i></i>
      <svg viewBox="0 0 24 28">
        <path d="M3 2.5v19.1l5.2-4.8 3.7 8.2 3.3-1.5-3.7-8.1h7.2z" />
      </svg>
    </span>
  </div>
  <div class="animation-footer">
    <p>
      <span class="animation-step" data-animation-step>
        01 / 05
      </span>
      <span data-animation-caption>Open the member directory</span>
    </p>
    <div>
      <button type="button" data-animation-pause aria-pressed="false">
        Pause animation
      </button>
      <button
        type="button"
        data-animation-replay
        aria-label="Replay product animation"
      >
        <Icon name="refresh" size={15} />
        <span>Replay</span>
      </button>
    </div>
  </div>
</figure>
<script>
  import '../scripts/product-preview';
</script>

<style>
  .product-preview {
    position: relative;
    z-index: 2;
    width: 100%;
    margin: 0;
    user-select: none;
  }

  .preview-window {
    position: relative;
    min-height: 676px;
    overflow: hidden;
    transform: none;
    transform-origin: 50% 100%;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: #0a0b0e;
    box-shadow:
      0 34px 90px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.018) inset;
    text-align: left;
    transition:
      transform 600ms var(--ease-out),
      border-color 240ms ease;
  }

  .product-preview:hover .preview-window {
    transform: none;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .window-bar {
    position: relative;
    min-height: 47px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    background: #0d0e12;
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .window-dots i {
    width: 7px;
    height: 7px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }

  .window-brand,
  .demo-state,
  .community-switcher,
  .main-toolbar,
  .member-count,
  .member-search,
  .filter-label,
  .directory-footer > span {
    display: flex;
    align-items: center;
  }

  .window-brand {
    gap: 8px;
    font-size: 0.875rem;
  }

  .window-brand :global(.brand-mark) {
    transform: rotate(-8deg) scale(0.72);
  }

  .window-brand strong {
    font-weight: 620;
  }

  .demo-state {
    justify-self: end;
    gap: 6px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .demo-state > i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(104, 185, 138, 0.09);
  }

  .demo-state span {
    color: var(--text-dim);
  }

  .demo-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    transform: scaleX(var(--demo-progress, 0));
    transform-origin: left;
    background: rgba(110, 155, 237, 0.72);
  }

  .app-shell {
    min-height: 629px;
    display: grid;
    grid-template-columns: 198px minmax(0, 1fr);
  }

  .preview-sidebar {
    display: flex;
    flex-direction: column;
    padding: 14px 12px;
    border-right: 1px solid var(--border);
    background: #0c0d10;
  }

  .community-switcher {
    gap: 9px;
    min-height: 48px;
    padding: 7px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.018);
  }

  .community-mark {
    width: 29px;
    height: 29px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(109, 149, 222, 0.24);
    border-radius: 7px;
    background: rgba(86, 137, 232, 0.1);
    color: #acc6f4;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .community-switcher > span:nth-child(2) {
    min-width: 0;
    flex: 1;
  }

  .community-switcher strong,
  .community-switcher small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .community-switcher strong {
    font-size: 0.875rem;
    font-weight: 610;
  }

  .community-switcher small {
    margin-top: 1px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .community-switcher > svg {
    transform: rotate(90deg);
    color: var(--text-dim);
  }

  .preview-sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 18px;
  }

  .preview-sidebar nav > span {
    min-height: 36px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 9px;
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .product-preview[data-demo-screen='overview'] .nav-overview,
  .product-preview[data-demo-screen='members'] .nav-members {
    border-color: var(--border);
    background: rgba(255, 255, 255, 0.04);
    color: #e6e6e9;
  }

  .preview-sidebar nav small {
    min-width: 17px;
    margin-left: auto;
    padding: 1px 4px;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-align: center;
  }

  .sidebar-trend {
    margin-top: auto;
    padding: 12px;
    border-top: 1px solid var(--border);
  }

  .sidebar-trend > div {
    display: flex;
    justify-content: space-between;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .sidebar-trend > div small,
  .trend-caption {
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .sidebar-trend svg {
    width: 100%;
    height: 42px;
    margin-block: 8px 5px;
    overflow: visible;
  }

  .sidebar-trend path {
    fill: none;
    stroke: rgba(103, 148, 231, 0.72);
    stroke-width: 1.4;
  }

  .preview-main {
    min-width: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.012), transparent 38%),
      #090a0d;
  }

  .main-toolbar {
    min-height: 50px;
    justify-content: space-between;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--border);
  }

  .main-toolbar p {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .main-toolbar p i {
    color: var(--text-faint);
    font-style: normal;
  }

  .main-toolbar p strong {
    color: var(--text-secondary);
    font-weight: 570;
  }

  .command-search {
    min-width: 142px;
    min-height: 28px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .command-search kbd {
    margin-left: auto;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .member-page {
    padding: clamp(24px, 3.2vw, 42px);
  }

  .page-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .preview-eyebrow {
    color: var(--blue);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .page-heading h3 {
    margin-top: 5px;
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    font-weight: 570;
    letter-spacing: -0.035em;
  }

  .page-heading > div > p:last-child {
    margin-top: 6px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .member-count {
    gap: 7px;
    min-height: 30px;
    padding: 0 9px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .member-directory {
    height: 516px;
    display: flex;
    flex-direction: column;
    margin-top: 26px;
    overflow: visible;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: #0d0f13;
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.2);
  }

  .member-table {
    min-height: 0;
  }

  .directory-toolbar {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border-bottom: 1px solid var(--border);
  }

  .member-search {
    min-width: 0;
    min-height: 38px;
    flex: 1;
    gap: 9px;
    padding: 0 11px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.14);
    color: var(--text-dim);
    font-size: 0.875rem;
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  [data-demo-phase='1'] .member-search {
    border-color: rgba(106, 151, 235, 0.42);
    background: rgba(86, 137, 232, 0.035);
  }

  .member-search > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .typing-caret {
    display: none;
    width: 1px;
    height: 14px;
    margin-left: -5px;
    background: #b8caf0;
    animation: caret-blink 800ms steps(1) infinite;
    animation-play-state: var(--motion-state, paused);
  }

  [data-demo-phase='1'] .typing-caret {
    display: block;
  }

  .filter-label {
    min-height: 38px;
    gap: 7px;
    padding: 0 11px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .table-head,
  .member-row {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(132px, 0.34fr) 86px;
    align-items: center;
    column-gap: 18px;
    padding-inline: 14px;
  }

  .table-head {
    min-height: 34px;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
  }

  .member-row {
    position: relative;
    z-index: 1;
    min-height: 72px;
    border-bottom: 1px solid var(--border);
    transition:
      min-height 320ms var(--ease-out),
      max-height 320ms var(--ease-out),
      padding 320ms var(--ease-out),
      opacity 220ms ease;
  }

  .member-row--featured {
    z-index: 5;
  }

  [data-demo-phase='2'] .member-row:not(.member-row--featured),
  [data-demo-phase='3'] .member-row:not(.member-row--featured),
  [data-demo-phase='4'] .member-row:not(.member-row--featured),
  [data-demo-phase='5'] .member-row:not(.member-row--featured) {
    min-height: 0;
    max-height: 0;
    overflow: hidden;
    padding-block: 0;
    border-bottom-color: transparent;
    opacity: 0;
  }

  .member-identity {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .member-avatar {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border-radius: 8px;
    object-fit: cover;
  }

  .identity-line {
    min-width: 0;
  }

  .identity-line strong,
  .identity-line small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .identity-line strong {
    color: #e6e6e9;
    font-size: 0.875rem;
    font-weight: 610;
  }

  .identity-line small {
    margin-top: 3px;
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .role-cell {
    position: relative;
  }

  .role-select {
    min-width: 122px;
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .role-select svg {
    width: 14px;
    fill: none;
    stroke: var(--text-dim);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 220ms ease;
  }

  [data-demo-phase='3'] .member-row--featured .role-select,
  [data-demo-phase='4'] .member-row--featured .role-select {
    border-color: rgba(106, 151, 235, 0.38);
    background: rgba(86, 137, 232, 0.055);
  }

  [data-demo-phase='3'] .member-row--featured .role-select svg,
  [data-demo-phase='4'] .member-row--featured .role-select svg {
