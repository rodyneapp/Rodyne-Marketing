---
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
---

<div
  class="discord-demo panel"
  data-discord-demo
  data-phase="done"
  data-log-phase="posted"
  data-typing="false"
>
  <div class="channel-bar">
    <span>
      <Icon name="discord" size={19} />
      <i>#</i>
      <strong>staff-commands</strong>
    </span>
    <small>Demo</small>
  </div>
  <p class="sr-only">
    Animated example: MiraNorth sends /ban chrxs_dev abuse of vehicle 7d. Rodyne
    responds “banning chrxs_dev”, then “Banned chrxs_dev” with a View Log link.
    MiraNorth then sends /modlogs chrxs_dev. Rodyne responds “processing”, then
    posts a moderation log showing the seven-day ban for abuse of vehicle,
    issued by MiraNorth, log #1042.
  </p>
  <div class="channel-body" aria-hidden="true">
    <div class="channel-intro">
      <span>#</span>
      <h3>staff-commands</h3>
      <p>Your team. Your commands. All in one place.</p>
    </div>
    <div class="message user-message">
      <span class="avatar">MN</span>
      <div>
        <div class="message-meta">
          <strong>MiraNorth</strong>
          <small>Today at 18:59</small>
        </div>
        <p class="command-tokens">
          <span class="slash-command">/ban</span>
          <span class="command-field">chrxs_dev</span>
          <span class="command-field">abuse of vehicle</span>
          <span class="command-field">7d</span>
        </p>
      </div>
    </div>
    <div class="message bot-message">
      <span class="avatar brand-avatar">
        <BrandMark />
      </span>
      <div class="bot-content">
        <div class="message-meta">
          <strong>Rodyne</strong>
          <span class="app-tag">
            <Icon name="check" size={10} />
            APP
          </span>
          <small>Today at 18:59</small>
        </div>
        <div class="bot-response">
          <p class="pending">
            <span class="spinner"></span>banning chrxs_dev
          </p>
          <p class="completed">
            <Icon name="check" size={18} />
            <span>Banned chrxs_dev</span>
            <span class="separator">·</span>
            <span class="log-label">View Log</span>
          </p>
        </div>
      </div>
    </div>
    <div class="message logs-command">
      <span class="avatar">MN</span>
      <div>
        <div class="message-meta">
          <strong>MiraNorth</strong>
          <small>Today at 19:00</small>
        </div>
        <p class="command-tokens">
          <span class="slash-command">/modlogs</span>
          <span class="command-field">chrxs_dev</span>
        </p>
      </div>
    </div>
    <div class="message logs-message">
      <span class="avatar brand-avatar">
        <BrandMark />
      </span>
      <div class="bot-content">
        <div class="message-meta">
          <strong>Rodyne</strong>
          <span class="app-tag">
            <Icon name="check" size={10} />
            APP
          </span>
          <small>Today at 19:00</small>
        </div>
        <p class="log-processing">
          <span class="spinner"></span>processing
        </p>
        <div class="log-embed">
          <div class="embed-heading">
            <strong>Moderation logs · chrxs_dev</strong>
          </div>
          <p class="embed-summary">1 moderation action on record</p>
          <dl class="log-fields">
            <div class="log-wide">
              <dt>Case #1042</dt>
              <dd>Ban · Active</dd>
            </div>
            <div class="log-wide">
              <dt>Reason</dt>
              <dd>abuse of vehicle</dd>
            </div>
            <div>
              <dt>Moderator</dt>
              <dd>MiraNorth</dd>
            </div>
            <div>
              <dt>Duration</dt>
              <dd>7 days</dd>
            </div>
          </dl>
          <div class="embed-footer">
            <span>Northwind City</span>
            <span>•</span>
            <time datetime="2026-09-12T18:59:00Z">12 Sep 2026, 18:59 UTC</time>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="composer" aria-hidden="true">
    <span class="add">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path
          d="M6 2v8M2 6h8"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span class="input-text">
      <span class="slash-command" data-command-token="/ban"></span>
      <span class="command-field" data-command-token="chrxs_dev"></span>
      <span class="command-field" data-command-token="abuse of vehicle"></span>
      <span class="command-field" data-command-token="7d"></span>
      <i class="caret"></i>
    </span>
    <span class="placeholder">Message #staff-commands</span>
    <span class="send">
      <Icon name="arrow" size={17} />
    </span>
  </div>
  <div class="demo-footer">
    <span>
      <Icon name="shield" size={13} />
      Staff-only commands
    </span>
    <button type="button" data-demo-pause aria-label="Pause Discord animation">
      Pause animation
    </button>
  </div>
</div>

<script>
  const demo = document.querySelector<HTMLElement>('[data-discord-demo]');
  if (demo) {
    const tokens = [
      ...demo.querySelectorAll<HTMLElement>('[data-command-token]'),
    ];
    const channel = demo.querySelector<HTMLElement>('.channel-body')!;
    const processing = demo.querySelector<HTMLElement>('.log-processing')!;
    const embed = demo.querySelector<HTMLElement>('.log-embed')!;
    const logCommand = demo.querySelector<HTMLElement>('.logs-command')!;
    let scrollFrom = 0;
    let scrollTo = 0;
    let scrollStarted = 0;
    const followMessages = () => {
      const target =
        demo.dataset.logPhase === 'posted'
          ? embed
          : demo.dataset.logPhase === 'processing'
            ? processing
            : demo.dataset.logPhase === 'sent'
              ? logCommand
              : null;
      scrollFrom = channel.scrollTop;
      scrollTo = target
        ? Math.max(
            0,
            channel.scrollTop +
              target.getBoundingClientRect().bottom -
              channel.getBoundingClientRect().top +
              24 -
              channel.clientHeight,
          )
        : 0;
      scrollTo = Math.min(
        scrollTo,
        channel.scrollHeight - channel.clientHeight,
      );
      scrollStarted = elapsed;
      if (reduced.matches) channel.scrollTop = scrollTo;
    };
    let previousLogPhase = '';
    const pause = demo.querySelector<HTMLButtonElement>('[data-demo-pause]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let elapsed = 0;
    let last = 0;
    let frame = 0;
    let visible = false;
    let paused = false;
    const render = () => {
      const time = elapsed % 19500;
      const logTyping = !reduced.matches && time >= 8400 && time < 10800;
      const logPhase =
        reduced.matches || time >= 13000
          ? 'posted'
          : time >= 11300
            ? 'processing'
            : time >= 10800
              ? 'sent'
              : 'hidden';
      const phase = reduced.matches
        ? 'done'
        : time < 700
          ? 'idle'
          : time < 4400
            ? 'typing'
            : time < 4900
              ? 'sent'
              : time < 6700
                ? 'pending'
                : 'done';
      if (demo.dataset.logPhase !== logPhase) demo.dataset.logPhase = logPhase;
      if (demo.dataset.phase !== phase) demo.dataset.phase = phase;
      const typing = String(phase === 'typing' || logTyping);
      if (demo.dataset.typing !== typing) demo.dataset.typing = typing;
      let characters = logTyping
        ? Math.floor((time - 8400) / 100)
        : demo.dataset.phase === 'typing'
          ? Math.floor((time - 700) / 90)
          : 0;
      for (const [index, token] of tokens.entries()) {
        const value = logTyping
          ? ['/modlogs', 'chrxs_dev', '', ''][index]
          : token.dataset.commandToken!;
        const text = value.slice(0, Math.max(0, characters));
        if (token.textContent !== text) token.textContent = text;
        characters -= value.length + 1;
      }
      if (demo.dataset.logPhase !== previousLogPhase) {
        previousLogPhase = demo.dataset.logPhase!;
        followMessages();
      }
      const scrollProgress = reduced.matches
        ? 1
        : Math.min(1, (elapsed - scrollStarted) / 320);
      const eased = 1 - Math.pow(1 - scrollProgress, 3);
      channel.scrollTop = scrollFrom + (scrollTo - scrollFrom) * eased;
    };
    const tick = (now: number) => {
      elapsed += last ? Math.min(now - last, 100) : 0;
      last = now;
      render();
      frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      cancelAnimationFrame(frame);
      last = 0;
      render();
      demo.dataset.running = String(
        visible && !paused && !document.hidden && !reduced.matches,
      );
      pause.hidden = reduced.matches;
      if (visible && !paused && !document.hidden && !reduced.matches)
        frame = requestAnimationFrame(tick);
    };
    pause.addEventListener('click', () => {
      paused = !paused;
      pause.textContent = paused ? 'Play animation' : 'Pause animation';
      pause.setAttribute('aria-pressed', String(paused));
      pause.setAttribute(
        'aria-label',
        paused ? 'Play Discord animation' : 'Pause Discord animation',
      );
      sync();
    });
    if ('IntersectionObserver' in window)
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.25 },
      ).observe(demo);
    else visible = true;
    if ('ResizeObserver' in window)
      new ResizeObserver(followMessages).observe(channel);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .discord-demo {
    min-width: 0;
    overflow: hidden;
    background: linear-gradient(145deg, #5865f20a, transparent 60%), #14151a;
  }
  .channel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 19px 24px;
    border-bottom: 1px solid var(--border);
  }
  .channel-bar > span {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .channel-bar :global(svg) {
    color: #a3a9ee;
  }
  .channel-bar i {
    font-style: normal;
    font-size: 21px;
    color: var(--text-dim);
  }
  .channel-bar strong {
    font-size: 0.875rem;
    font-weight: 550;
  }
  .channel-bar small {
    font: 0.6875rem var(--mono);
    color: var(--text-dim);
  }
  .channel-body {
    position: relative;
    height: 590px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #41434d transparent;
    padding: 27px 24px 20px;
  }
  .channel-intro {
    margin-bottom: 25px;
  }
  .channel-intro > span {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: #ffffff07;
    border-radius: 12px;
    color: var(--text-secondary);
    font-size: 24px;
  }
  .channel-intro h3 {
    margin-top: 12px;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .channel-intro p {
    margin-top: 5px;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .message {
    display: flex;
    gap: 12px;
    margin-top: 23px;
    transition:
      opacity 200ms var(--ease-out),
      transform 240ms var(--ease-out);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #ac91d52b;
    color: #c4abd9;
    font-size: 0.6875rem;
  }
  .brand-avatar {
    --brand-mark-size: 26px;
    background: #09090b;
    border: 1px solid #759bff30;
  }
  .message-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    min-height: 18px;
  }
  .message-meta strong {
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .user-message .message-meta strong {
    color: #baa8d2;
  }
  .message-meta small {
    font-size: 0.625rem;
    color: var(--text-faint);
  }
  .message p {
    font-size: 0.8125rem;
    margin-top: 6px;
    color: var(--text-secondary);
  }
  .slash-command {
    color: #a9b4fb;
    background: #5865f221;
    border-radius: 3px;
    padding: 2px 3px;
  }
  .app-tag {
    display: inline-flex;
    gap: 2px;
    align-items: center;
    padding: 2px 4px;
    border-radius: 3px;
    background: #5865f2;
    color: white;
    font-size: 0.5rem;
    font-weight: 600;
  }
  .bot-content {
    min-width: 0;
    flex: 1;
  }
  .bot-response {
    display: grid;
  }
  .bot-response p {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    min-height: 22px;
  }
  .completed :global(svg) {
    color: var(--green);
    flex-shrink: 0;
  }
  .separator {
    color: var(--text-dim);
  }
  .log-label {
    color: #a8bbf1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .spinner {
    width: 12px;
    height: 12px;
    border: 1.5px solid #ffffff20;
    border-top-color: #aab7eb;
    border-radius: 50%;
    animation: spin 800ms linear infinite;
  }
  .composer {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 76px;
    margin: 0 24px 18px;
    padding: 0 13px;
    border: 1px solid #ffffff09;
    border-radius: 8px;
    background: #ffffff06;
    font-size: 0.8125rem;
  }
  .add {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #a5a6b5;
    color: #23242b;
    width: 17px;
    height: 17px;
    line-height: 1;
    flex-shrink: 0;
  }
  .add svg {
    display: block;
  }
  .input-text,
  .command-tokens {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }
  .input-text {
    flex: 1;
  }
  .command-field {
    display: inline-block;
    padding: 2px 5px;
    border: 1px solid #a5aff52b;
    border-radius: 4px;
    background: #a5aff514;
    color: #d5dafa;
    white-space: nowrap;
  }
  [data-command-token]:empty,
  [data-typing='false'] .input-text {
    display: none;
  }
  .user-message > div {
    min-width: 0;
  }

  .placeholder {
    color: var(--text-faint);
  }
  .caret {
    height: 16px;
    width: 1px;
    background: #c9cbda;
    flex-shrink: 0;
  }
  .send {
    margin-left: auto;
    color: var(--text-faint);
    flex-shrink: 0;
  }
  .demo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 24px;
    border-top: 1px solid var(--border);
    font-size: 0.6875rem;
    color: var(--text-dim);
  }
  .demo-footer > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .demo-footer button {
    padding: 3px 0;
    background: none;
    border: 0;
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
  }
  .demo-footer button[hidden] {
    display: none;
  }
  .demo-footer button:focus-visible {
    outline: 2px solid #a8bbf1;
    outline-offset: 4px;
  }
  [data-phase='idle'] .message,
  [data-phase='typing'] .message,
  [data-phase='sent'] .bot-message {
    opacity: 0;
    transform: translateY(5px);
  }
  [data-typing='false'] .caret,
  [data-typing='true'] .placeholder {
    display: none;
  }
  [data-phase]:not([data-phase='done']) .completed,
  [data-phase='done'] .pending {
    visibility: hidden;
  }
  .logs-command > div {
    min-width: 0;
  }
  .logs-command .message-meta strong {
    color: #baa8d2;
  }
  [data-log-phase='hidden'] .logs-command,
  [data-log-phase='hidden'] .logs-message,
  [data-log-phase='sent'] .logs-message {
    opacity: 0;
    transform: translateY(5px);
  }
  .log-processing {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  [data-log-phase]:not([data-log-phase='processing']) .log-processing,
  [data-log-phase]:not([data-log-phase='posted']) .log-embed {
    display: none;
  }
  .log-embed {
    margin-top: 9px;
    padding: 15px 16px;
    border: 1px solid #ffffff09;
    border-left: 4px solid #8f9be8;
    max-width: 520px;
    overflow-wrap: anywhere;
    border-radius: 4px;
    background: #0e0f1480;
  }
  .embed-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #f2f3f5;
  }
  .embed-heading strong {
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .log-embed .embed-summary {
    font-size: 0.6875rem;
    color: var(--text-dim);
    margin-top: 6px;
  }
  .log-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
    font-size: 0.75rem;
  }
  .log-wide {
    grid-column: 1 / -1;
  }
  .log-fields dt {
    color: #dbdee1;
    font-weight: 600;
    font-size: 0.75rem;
    margin-bottom: 3px;
  }
  .log-fields dd {
    margin: 0;
    color: var(--text-secondary);
  }
  .embed-footer {
    flex-wrap: wrap;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 15px;
    font-size: 0.625rem;
    color: var(--text-dim);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  [data-running='false'] .spinner {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .message {
      transition: none;
    }
    .spinner {
      animation: none;
    }
  }
  @media (max-width: 480px) {
    .channel-bar,
    .demo-footer {
      padding-inline: 16px;
    }
    .channel-body {
      padding-inline: 16px;
      height: 610px;
    }
    .composer {
      margin-inline: 16px;
      gap: 9px;
      font-size: 0.75rem;
      height: 94px;
    }
    .message {
      gap: 9px;
    }
  }
</style>
