---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/blog.css';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<SiteLayout
  title="Blog — Relay"
  description="News, press releases and changelogs from Relay."
  pageType="webpage"
>
  <Header />
  <main id="main-content" class="blog-shell">
    <header class="blog-heading">
      <p class="eyebrow">From the Relay team</p>
      <h1 class="display">Blog</h1>
      <p>Product updates, announcements and the details behind what’s new.</p>
    </header>
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <a href={`/blog/${post.id}/`}>
            <div class="post-meta">
              <span class="post-category">{post.data.category}</span>
              <time datetime={post.data.date.toISOString()}>
                {dateFormat.format(post.data.date)}
              </time>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="read-post">
              Read post <span aria-hidden="true">↗</span>
            </span>
          </a>
        </article>
      ))}
      {posts.length === 0 && (
        <p class="blog-empty">
          Our first update is on its way. Check back soon.
        </p>
      )}
    </div>
  </main>
  <Footer />
</SiteLayout>
